# Base images are pinned by digest; the tag each one was taken from is noted
# above it. Update both together.
# python:3.12-slim
FROM docker.io/library/python@sha256:4840d514c583a4d3d8cad3940e68dee6f0f6f3635c12fcd0a3d74c21a5b93a54 AS dependencies

# uv 0.13.5
COPY --from=ghcr.io/astral-sh/uv@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff /uv /uvx /usr/local/bin/
WORKDIR /opt/clashlens
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project

# The Noto fonts the Discord bot's attack alert picture falls back to for
# names in other scripts, symbols and emoji (src/bot/picture.py): about 34 MB
# of the packages' few hundred.
# python:3.12-slim
FROM docker.io/library/python@sha256:4840d514c583a4d3d8cad3940e68dee6f0f6f3635c12fcd0a3d74c21a5b93a54 AS fonts
RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-noto-core fonts-noto-cjk fonts-noto-color-emoji

# python:3.12-slim
FROM docker.io/library/python@sha256:4840d514c583a4d3d8cad3940e68dee6f0f6f3635c12fcd0a3d74c21a5b93a54

# FriBiDi lets Pillow lay out text with the website font's features and
# right-to-left names.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libfribidi0 \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 10001 clashlens \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin clashlens
COPY --from=fonts /usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc /usr/share/fonts/opentype/noto/
COPY --from=fonts \
    /usr/share/fonts/truetype/noto/NotoSans-Bold.ttf \
    /usr/share/fonts/truetype/noto/NotoSansKhmer-Bold.ttf \
    /usr/share/fonts/truetype/noto/NotoSansArabic-Bold.ttf \
    /usr/share/fonts/truetype/noto/NotoSansThai-Bold.ttf \
    /usr/share/fonts/truetype/noto/NotoSansDevanagari-Bold.ttf \
    /usr/share/fonts/truetype/noto/NotoSansHebrew-Bold.ttf \
    /usr/share/fonts/truetype/noto/NotoSansBengali-Bold.ttf \
    /usr/share/fonts/truetype/noto/NotoSansTamil-Bold.ttf \
    /usr/share/fonts/truetype/noto/NotoSansMyanmar-Bold.ttf \
    /usr/share/fonts/truetype/noto/NotoSansGeorgian-Bold.ttf \
    /usr/share/fonts/truetype/noto/NotoSansArmenian-Bold.ttf \
    /usr/share/fonts/truetype/noto/NotoSansJavanese-Bold.ttf \
    /usr/share/fonts/truetype/noto/NotoSansSymbols-Bold.ttf \
    /usr/share/fonts/truetype/noto/NotoSerifTibetan-Bold.ttf \
    /usr/share/fonts/truetype/noto/NotoSansSymbols2-Regular.ttf \
    /usr/share/fonts/truetype/noto/NotoSansMath-Regular.ttf \
    /usr/share/fonts/truetype/noto/NotoColorEmoji.ttf \
    /usr/share/fonts/truetype/noto/
COPY --from=dependencies /opt/clashlens/.venv /opt/venv
COPY src /opt/clashlens/src
RUN mkdir -p /opt/clashlens/testdata
COPY testdata/legend_i_profile_v1.json /opt/clashlens/testdata/legend_i_profile_v1.json
ENV PATH=/opt/venv/bin:$PATH PYTHONPATH=/opt/clashlens/src PYTHONDONTWRITEBYTECODE=1
WORKDIR /opt/clashlens
VOLUME ["/spool"]
USER 10001:10001
ENTRYPOINT ["python", "-m", "clashlens.cli"]
