[Unit]
Description=Clash Lens Python prototype stack
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/clashlens/python-prototype
Environment=DEPLOY_ENV_FILE=%h/.config/clashlens-python-prototype/prototype.env
ExecStart=%h/clashlens/python-prototype/deploy.sh up
ExecStop=%h/clashlens/python-prototype/deploy.sh down
TimeoutStartSec=15min
TimeoutStopSec=2min

[Install]
WantedBy=default.target
