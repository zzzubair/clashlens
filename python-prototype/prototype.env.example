# Copy this file to prototype.env or let deploy.sh create it on first init.
# Secrets and HMAC keys are generated in CLASHLENS_SECRET_DIR. Do not place secret values here.
POSTGRES_DB=clashlens_prototype
POSTGRES_USER=clashlens_prototype
CLASHLENS_API_PORT=18080
CLASHLENS_API_MAX_BODY_BYTES=1048576
CLASHLENS_ARCHIVE_ENDPOINT=archive-fixture:9000
CLASHLENS_ARCHIVE_BUCKET=evidence
CLASHLENS_ARCHIVE_SECURE=true
CLASHLENS_ARCHIVE_MAX_BODY_BYTES=2000000
CLASHLENS_ARCHIVE_CONNECT_TIMEOUT_SECONDS=5
CLASHLENS_ARCHIVE_READ_TIMEOUT_SECONDS=15
CLASHLENS_ARCHIVE_MAX_RETRIES=1
CLASHLENS_ARCHIVE_RETRY_BACKOFF_SECONDS=0.1
CLASHLENS_HMAC_CALLER=typescript-website
CLASHLENS_HMAC_KEY_ID=current
CLASHLENS_HMAC_PREVIOUS_KEY_ID=previous
