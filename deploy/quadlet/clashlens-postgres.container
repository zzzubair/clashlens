# Managed by Clash Lens ./ops.
[Unit]
Description=Clash Lens PostgreSQL
PartOf=clashlens.target
Requires=clashlens-pod.service
After=clashlens-pod.service

[Container]
Label=org.clashlens.managed=ops
Image=@@POSTGRES_IMAGE@@
Pull=never
ContainerName=@@PREFIX@@-postgres
StopTimeout=85
User=0
Volume=clashlens-postgres.volume:/var/lib/postgresql/data
EnvironmentFile=@@ENV_DIR@@/postgres.env
Secret=clashlens-postgres-password,type=mount,target=/run/secrets/postgres-password,uid=0,gid=0,mode=0400
@@BACKUP_SECRET@@
Memory=@@POSTGRES_MEMORY@@
PidsLimit=@@POSTGRES_PIDS@@
PodmanArgs=--pod=@@PREFIX@@-pod --cpus=@@POSTGRES_CPUS@@
HealthCmd=pg_isready -U @@POSTGRES_USER@@ -d @@POSTGRES_DB@@
HealthInterval=10s
HealthTimeout=5s
HealthRetries=12
HealthOnFailure=kill
# Crash recovery replays up to max_wal_size: 845 MB took 90 s on rogue, so
# 2 GB is about 3.5 minutes. Failed checks then must not restart the replay.
HealthStartPeriod=5min
Notify=healthy
# Write volume: data checksums log a full 8 KB page the first time each page
# changes after a checkpoint, so checkpoints are spaced out and those copies
# compressed. The larger cache writes a changed page once per checkpoint
# instead of on every eviction.
Exec=postgres -c shared_preload_libraries=pg_stat_statements -c pg_stat_statements.track=all -c track_io_timing=on -c track_wal_io_timing=on -c shared_buffers=@@POSTGRES_SHARED_BUFFERS@@ -c wal_compression=zstd -c checkpoint_timeout=10min -c max_wal_size=2GB @@POSTGRES_ARCHIVE_ARGS@@

[Service]
Restart=always
RestartMode=direct
TimeoutStartSec=5min
TimeoutStopSec=90
