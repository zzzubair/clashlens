# Managed by Clash Lens ./ops.
# The Discord bot. ./ops installs this unit in every mode but starts it only
# when app.env sets CLASHLENS_DISCORD_BOT=on in production; see
# docs/discord-bot.md. It connects out to Discord and listens on no port.
[Unit]
Description=Clash Lens Discord bot
PartOf=clashlens.target
Requires=clashlens-pod.service
After=clashlens-pod.service clashlens-postgres.service

[Container]
Label=org.clashlens.managed=ops
Image=@@PYTHON_IMAGE@@
Pull=never
ContainerName=@@PREFIX@@-discord-bot
# The bot runs the private API's read code with the API's database role.
Secret=clashlens-api-database-url,type=mount,target=/run/secrets/database-url,uid=10001,gid=10001,mode=0400
Secret=clashlens-discord-bot-token,type=mount,target=/run/secrets/discord-bot-token,uid=10001,gid=10001,mode=0400
Environment=CLASHLENS_DATABASE_URL_FILE=/run/secrets/database-url
Environment=CLASHLENS_DISCORD_BOT_TOKEN_FILE=/run/secrets/discord-bot-token
Environment=CLASHLENS_PUBLIC_ORIGIN=@@PUBLIC_ORIGIN@@
ReadOnly=true
Tmpfs=/tmp:rw,noexec,nosuid,nodev,size=16m
DropCapability=all
NoNewPrivileges=true
Memory=384m
PidsLimit=64
PodmanArgs=--pod=@@PREFIX@@-pod --cpus=0.5 --entrypoint=python
Exec=-m bot run

[Service]
Restart=always
RestartSec=10
TimeoutStopSec=30
