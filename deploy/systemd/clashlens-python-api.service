[Unit]
Description=Clash Lens private Python API
Requires=clashlens.service
After=network-online.target clashlens.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/clashlens
ExecStart=%h/clashlens/deploy.sh api-start
ExecStop=%h/clashlens/deploy.sh api-down
TimeoutStartSec=10min
TimeoutStopSec=2min

[Install]
WantedBy=default.target
