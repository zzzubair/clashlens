trial_recovery_snapshot() {
  local pending_handoffs sidecars incomplete_uploads incomplete_processing
  local duplicate_completions spool_objects
  incomplete_uploads=$("$PODMAN_BIN" exec "$POSTGRES" psql -Atq -U clashlens -d clashlens \
    -c "SELECT count(*) FROM collector_response_uploads WHERE state <> 'complete'")
  incomplete_processing=$("$PODMAN_BIN" exec "$POSTGRES" psql -Atq -U clashlens -d clashlens \
    -c "SELECT count(*) FROM python_processing_jobs
         WHERE work_type = 'process_observation' AND status <> 'complete'")
  duplicate_completions=$("$PODMAN_BIN" exec "$POSTGRES" psql -Atq -U clashlens -d clashlens \
    -c "SELECT count(*) FROM (
          SELECT job_id FROM python_processing_attempts
          WHERE state = 'complete' AND started_at >= '$TRIAL_STARTED_AT'
          GROUP BY job_id HAVING count(*) > 1
        ) AS duplicate")
  sidecars=$("$PODMAN_BIN" run --rm --volume "$SPOOL_VOLUME:/spool:ro,z" \
    --entrypoint /bin/sh "$IMAGE_PREFIX-fixtures" \
    -c "find /spool/.handoff -mindepth 1 -maxdepth 1 -type f | wc -l")
  pending_handoffs=$sidecars
  spool_objects=$("$PODMAN_BIN" run --rm --volume "$SPOOL_VOLUME:/spool:ro,z" \
    --entrypoint /bin/sh "$IMAGE_PREFIX-fixtures" \
    -c "find /spool/sha256 -mindepth 2 -maxdepth 2 -type f | wc -l")
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$pending_handoffs" "$sidecars" "$incomplete_uploads" \
    "$incomplete_processing" "$duplicate_completions" "$spool_objects"
}

