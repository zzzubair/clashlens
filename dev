trial_swap_snapshot() {
  awk '
    /^SwapTotal:/ { total = $2 }
    /^SwapFree:/ { free = $2 }
    END {
      if (total == "" || free == "") exit 1
      printf "%.0f\n", (total - free) * 1024
    }
  ' /proc/meminfo
}

trial_swap_monitor() {
  local peak=$TRIAL_SWAP_BEFORE_BYTES current
  while [[ ! -e "$STATE_DIR/trial-swap-stop" ]]; do
    current=$(trial_swap_snapshot)
    (( current > peak )) && peak=$current
    printf '%s\n' "$peak" > "$STATE_DIR/trial-swap-peak.tsv"
    sleep 1
  done
}

trial_service_snapshot() {
  local service name state
  for service in postgres archive clash-api login collector api worker website; do
    name=$(container_name "$service")
    state=$("$PODMAN_BIN" inspect --format \
      '{{.State.Status}}/{{.State.ExitCode}}/{{.State.OOMKilled}}' "$name" 2>/dev/null || \
      printf 'missing/-/-')
    printf '%s\t%s\n' "$service" "$state"
  done
}

stop_trial_producers() {
  local result=0 name state
  for name in "$COLLECTOR" "$WORKER"; do
    state=$("$PODMAN_BIN" inspect --format '{{.State.Status}}' "$name" 2>/dev/null || \
      printf missing)
    if [[ "$state" == running ]]; then
      "$PODMAN_BIN" stop --time 30 "$name" >/dev/null || result=1
    fi
  done
  return "$result"
}

pause_trial_producers() {
  local result=0 name state
  for name in "$COLLECTOR" "$WORKER"; do
    state=$("$PODMAN_BIN" inspect --format '{{.State.Status}}' "$name" 2>/dev/null || \
      printf missing)
    if [[ "$state" == running ]]; then
      "$PODMAN_BIN" pause "$name" >/dev/null || result=1
    fi
  done
  return "$result"
}

resume_trial_producers() {
  local result=0 name state
  for name in "$COLLECTOR" "$WORKER"; do
    state=$("$PODMAN_BIN" inspect --format '{{.State.Status}}' "$name" 2>/dev/null || \
      printf missing)
    if [[ "$state" == paused ]]; then
      "$PODMAN_BIN" unpause "$name" >/dev/null || result=1
    fi
  done
  return "$result"
}

start_trial_producers() {
  "$PODMAN_BIN" rm "$COLLECTOR" "$WORKER" >/dev/null
  start_worker
  start_collector

  local attempt collector_state worker_state
  for attempt in $(seq 1 30); do
    collector_state=$("$PODMAN_BIN" inspect --format '{{.State.Status}}' "$COLLECTOR" 2>/dev/null || \
      printf missing)
    worker_state=$("$PODMAN_BIN" inspect --format '{{.State.Status}}' "$WORKER" 2>/dev/null || \
      printf missing)
    if [[ "$collector_state" == running && "$worker_state" == running ]] && \
      "$PODMAN_BIN" exec "$COLLECTOR" python -c \
        "import urllib.request; print(urllib.request.urlopen('http://127.0.0.1:8081/livez', timeout=2).read().decode(), end='')" | grep -qx ok; then
      return
    fi
    sleep 1
  done
  "$PODMAN_BIN" logs --tail 80 "$COLLECTOR" 2>&1 || true
  "$PODMAN_BIN" logs --tail 80 "$WORKER" 2>&1 || true
  die "trial collector and worker did not become ready"
}

restart_trial_producers() {
  "$PODMAN_BIN" kill "$COLLECTOR" "$WORKER" >/dev/null
  start_trial_producers
}

