          0,
          0,
          (SELECT count(*) FROM python_processing_attempts
            WHERE completed_at >= '$TRIAL_STARTED_AT' AND completed_at <= '$TRIAL_ENDED_AT'
              AND outcome = 'durable_failure'),
          (SELECT count(*) FROM python_processing_attempts
