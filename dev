trial_report() {
  local before_requests after_requests requests
  read -r before_requests < "$STATE_DIR/trial-before-counters.tsv"
  read -r after_requests < "$STATE_DIR/trial-after-counters.tsv"
  requests=$((after_requests - before_requests))
  local requests_per_second
  requests_per_second=$(awk -v requests="$requests" -v seconds="$TRIAL_SECONDS" \
    'BEGIN { if (seconds > 0) printf "%.3f", requests / seconds; else print "0.000" }')

  local transport_failures non_2xx_responses collector_failures collector_lease_expiries
  local collector_retries collector_deferrals worker_failures worker_lease_expiries
  local worker_retries worker_deferrals
  IFS=$'\t' read -r transport_failures non_2xx_responses collector_failures \
    collector_lease_expiries collector_retries collector_deferrals worker_failures \
    worker_lease_expiries worker_retries worker_deferrals \
    < "$STATE_DIR/trial-failures.tsv"

  local registered_players active_players collector_pending
  local collector_waiting_retry collector_waiting_dependency collector_failed
  local worker_pending worker_leased worker_waiting_retry worker_waiting_dependency worker_failed
  IFS=$'\t' read -r registered_players active_players collector_pending \
    collector_waiting_retry collector_waiting_dependency collector_failed \
    worker_pending worker_leased worker_waiting_retry worker_waiting_dependency worker_failed \
    < "$STATE_DIR/trial-backlog.tsv"

  printf 'Trial complete (%s synthetic players, %s minutes requested, %ss measured).\n' \
    "$PLAYERS" "$TRIAL_MINUTES" "$TRIAL_SECONDS"
  printf 'requests/sec achieved: %s\n' "$requests_per_second"
  local report_status=0 service state
  local endpoint label revisit_median revisit_worst revisited_players endpoint_requests
  for endpoint in profile battle_log; do
    [[ "$endpoint" == profile ]] && label=profile || label=battle-log
    IFS=$'\t' read -r revisit_median revisit_worst revisited_players \
      endpoint_requests < "$STATE_DIR/trial-$endpoint-revisit.tsv"
    if (( revisited_players > 0 )); then
      printf '%s per-player revisit gap: median %.3fs, worst %.3fs (%s/%s players, %s requests)\n' \
        "$label" "$revisit_median" "$revisit_worst" "$revisited_players" \
        "$PLAYERS" "$endpoint_requests"
      awk -v median="$revisit_median" -v worst="$revisit_worst" \
        -v seen="$revisited_players" -v requests="$endpoint_requests" \
        -v expected="$PLAYERS" \
        'BEGIN { exit !(seen == expected && requests >= 2 * expected && median < 300 && worst < 600) }' || \
        report_status=1
    else
      printf '%s per-player revisit gap: unavailable (0/%s requested players revisited)\n' \
        "$label" "$PLAYERS"
      report_status=1
    fi
  done
  printf 'population at cutoff: registered=%s/%s, active=%s/%s\n' \
    "$registered_players" "$PLAYERS" "$active_players" "$PLAYERS"
  [[ "$registered_players" == "$PLAYERS" && "$active_players" == "$PLAYERS" ]] || \
    report_status=1
  printf 'failures during window: transport=%s, non_2xx=%s, collector_terminal=%s, worker_terminal=%s\n' \
    "$transport_failures" "$non_2xx_responses" "$collector_failures" "$worker_failures"
  [[ "$transport_failures" == 0 && "$non_2xx_responses" == 0 && \
     "$collector_failures" == 0 && "$worker_failures" == 0 ]] || report_status=1
  printf 'lease expiries during window: collector=%s, worker=%s\n' \
    "$collector_lease_expiries" "$worker_lease_expiries"
  printf 'retries/deferrals during window: collector=%s/%s, worker=%s/%s\n' \
    "$collector_retries" "$collector_deferrals" "$worker_retries" "$worker_deferrals"
  printf 'backlog at cutoff: collector pending=%s retry=%s dependency=%s failed=%s; worker pending=%s leased=%s retry=%s dependency=%s failed=%s\n' \
    "$collector_pending" "$collector_waiting_retry" \
    "$collector_waiting_dependency" "$collector_failed" "$worker_pending" "$worker_leased" \
    "$worker_waiting_retry" "$worker_waiting_dependency" "$worker_failed"
  printf 'service states at cutoff:'
  while IFS=$'\t' read -r service state; do
    printf ' %s=%s' "$service" "$state"
    if [[ "$service" == collector || "$service" == worker ]]; then
      [[ "$state" == paused/0/false ]] || report_status=1
    else
      [[ "$state" == running/* ]] || report_status=1
    fi
  done < "$STATE_DIR/trial-cutoff-services.tsv"
  printf '\nproducer exits after cutoff:'
  while IFS=$'\t' read -r service state; do
    [[ "$service" == collector || "$service" == worker ]] || continue
    printf ' %s=%s' "$service" "$state"
    [[ "$state" == exited/0/false ]] || report_status=1
  done < "$STATE_DIR/trial-after-stop-services.tsv"
  printf '\n'
  local pending_handoffs sidecars incomplete_uploads incomplete_processing
  local duplicate_completions spool_objects database_before database_after
  local fixture_final acknowledged
  IFS=$'\t' read -r pending_handoffs sidecars incomplete_uploads \
    incomplete_processing duplicate_completions spool_objects \
    < "$STATE_DIR/trial-recovery.tsv"
  read -r database_before < "$STATE_DIR/trial-before-database-counter.tsv"
  read -r database_after < "$STATE_DIR/trial-after-database-counter.tsv"
  read -r fixture_final < "$STATE_DIR/trial-final-fixture-counter.tsv"
  acknowledged=$((database_after - database_before))
  printf 'kill/restart recovery: acknowledged=%s/%s, pending handoffs=%s, sidecars=%s, pending uploads=%s, pending processing=%s, duplicate completions=%s, spool objects=%s\n' \
    "$acknowledged" "$fixture_final" "$pending_handoffs" "$sidecars" \
    "$incomplete_uploads" "$incomplete_processing" "$duplicate_completions" \
    "$spool_objects"
  [[ "$acknowledged" == "$fixture_final" && "$pending_handoffs" == 0 && \
     "$sidecars" == 0 && "$incomplete_uploads" == 0 && \
     "$incomplete_processing" == 0 && "$duplicate_completions" == 0 && \
     "$spool_objects" == 0 ]] || report_status=1
  awk -v before="$TRIAL_SWAP_BEFORE_BYTES" -v peak="$TRIAL_SWAP_PEAK_BYTES" \
    -v after="$TRIAL_SWAP_AFTER_BYTES" '
    BEGIN {
      printf "swap use: start %.3f MiB, peak %.3f MiB, end %.3f MiB, peak delta %.3f MiB\n",
        before / 1048576, peak / 1048576, after / 1048576,
        (peak - before) / 1048576
    }
  '
  (( TRIAL_SWAP_PEAK_BYTES <= TRIAL_SWAP_BEFORE_BYTES )) || report_status=1
  printf 'database growth (MiB by table):\n'
  awk -F '\t' '
    NR == FNR { before[$1] = $2; next }
    { printf "  %s: %.3f\n", $1, ($2 - before[$1]) / 1048576 }
  ' "$STATE_DIR/trial-before-db.tsv" "$STATE_DIR/trial-after-db.tsv"
  local growth_bytes projected_gib
  growth_bytes=$(awk -F '\t' '
    NR == FNR { before[$1] = $2; next }
    { growth = $2 - before[$1]; if (growth > 0) total += growth }
    END { printf "%.0f", total }
  ' "$STATE_DIR/trial-before-db.tsv" "$STATE_DIR/trial-after-db.tsv")
  projected_gib=$(awk -v bytes="$growth_bytes" -v seconds="$TRIAL_SECONDS" '
    BEGIN { printf "%.3f", bytes * 3600 / seconds * 24 * 182.625 / 1073741824 }
  ')
  printf 'database growth rate: %.3f MiB/hour; six-month projection: %s GiB (baseline 166-185 GiB)\n' \
    "$(awk -v bytes="$growth_bytes" -v seconds="$TRIAL_SECONDS" \
      'BEGIN { printf "%.3f", bytes * 3600 / seconds / 1048576 }')" \
    "$projected_gib"
  awk -v projected="$projected_gib" 'BEGIN { exit !(projected <= 185) }' || \
    report_status=1
  return "$report_status"
}

trial_inner() {
  parse_trial_args "$@"
  local scope=${CLASHLENS_TRIAL_SCOPE:-}
  [[ "$scope" =~ ^trial-[0-9]+-[0-9]+-[0-9]+$ ]] || \
    die "invalid internal trial scope"
  select_project "$scope"
  CLASHLENS_DEV_TRIAL=true
  up_stack true
  stop_trial_producers
  trial_db_snapshot > "$STATE_DIR/trial-before-db.tsv"
  trial_database_counter_snapshot > "$STATE_DIR/trial-before-database-counter.tsv"
  trial_reset_fixture_stats
  printf '0\n' > "$STATE_DIR/trial-before-counters.tsv"
  TRIAL_SWAP_BEFORE_BYTES=$(trial_swap_snapshot)
  local swap_monitor_pid=""
  trap 'if [[ -n "$swap_monitor_pid" ]]; then kill "$swap_monitor_pid" 2>/dev/null || true; wait "$swap_monitor_pid" 2>/dev/null || true; fi' EXIT
  trial_swap_monitor &
  swap_monitor_pid=$!
  read -r TRIAL_STARTED_AT TRIAL_STARTED_NANOSECONDS < <(
    date -u '+%Y-%m-%dT%H:%M:%S.%NZ %s%N'
  )
  start_trial_producers
  local deadline_nanoseconds remaining_seconds restart_delay
  deadline_nanoseconds=$((TRIAL_STARTED_NANOSECONDS + TRIAL_MINUTES * 60 * 1000000000))
  restart_delay=$((TRIAL_MINUTES * 30))
  (( restart_delay > 60 )) && restart_delay=60
  sleep "$restart_delay"
  restart_trial_producers
  remaining_seconds=$(awk -v deadline="$deadline_nanoseconds" -v now="$(date +%s%N)" '
    BEGIN {
      remaining = (deadline - now) / 1000000000
      if (remaining < 0) remaining = 0
      printf "%.9f", remaining
    }
  ')
  sleep "$remaining_seconds"
  pause_trial_producers || true
  read -r TRIAL_ENDED_AT TRIAL_ENDED_NANOSECONDS < <(
    date -u '+%Y-%m-%dT%H:%M:%S.%NZ %s%N'
  )
  TRIAL_SECONDS=$(awk -v start="$TRIAL_STARTED_NANOSECONDS" \
    -v end="$TRIAL_ENDED_NANOSECONDS" \
    'BEGIN { printf "%.3f", (end - start) / 1000000000 }')
  trial_fixture_counter_snapshot > "$STATE_DIR/trial-after-counters.tsv"
  for endpoint in profile battle_log; do
    trial_revisit_snapshot "$endpoint" > "$STATE_DIR/trial-$endpoint-revisit.tsv"
  done
  trial_service_snapshot > "$STATE_DIR/trial-cutoff-services.tsv"
  trial_db_snapshot > "$STATE_DIR/trial-after-db.tsv"
  TRIAL_SWAP_AFTER_BYTES=$(trial_swap_snapshot)
  : > "$STATE_DIR/trial-swap-stop"
  wait "$swap_monitor_pid"
  swap_monitor_pid=""
  read -r TRIAL_SWAP_PEAK_BYTES < "$STATE_DIR/trial-swap-peak.tsv"
  trial_failure_snapshot > "$STATE_DIR/trial-failures.tsv"
  trial_backlog_snapshot > "$STATE_DIR/trial-backlog.tsv"
  resume_trial_producers || true
  stop_trial_producers || true
  trial_service_snapshot > "$STATE_DIR/trial-after-stop-services.tsv"
  trial_database_counter_snapshot > "$STATE_DIR/trial-after-database-counter.tsv"
  trial_fixture_counter_snapshot > "$STATE_DIR/trial-final-fixture-counter.tsv"
  trial_recovery_snapshot > "$STATE_DIR/trial-recovery.tsv"
  local report_status=0
  trial_report || report_status=$?
  trap - EXIT
  return "$report_status"
}

trial() {
  parse_trial_args "$@"
  local scope="trial-$(date +%s%N)-$RANDOM-$$"
  select_project "$scope"
  trap 'trial_cleanup || true' EXIT INT TERM
  local result=0
  CLASHLENS_TRIAL_SCOPE="$scope" timeout --kill-after=30s \
    "$((TRIAL_MINUTES * 60 + 600))" "$ROOT/dev" trial-inner \
    --players "$PLAYERS" --minutes "$TRIAL_MINUTES" || result=$?
  local cleanup_result=0
  trial_cleanup || cleanup_result=$?
  if [[ "$result" == 0 && "$cleanup_result" != 0 ]]; then
    result=$cleanup_result
  fi
  trap - EXIT INT TERM
  return "$result"
}

main() {
  (($#)) || { usage; exit 2; }
  local command=$1
  shift
  if [[ "$command" == help || "$command" == -h || "$command" == --help ]]; then
    usage
    return
  fi
  require_podman
  case "$command" in
    up)
      parse_players "$@"
      select_project dev
      up_stack false
      ;;
    down)
      parse_players "$@"
      select_project dev
      remove_stack false
      printf 'Clash Lens is down; local database, archive, and spool data were kept.\n'
      ;;
    status)
      parse_players "$@"
      select_project dev
      show_status
      ;;
    logs)
      local service=""
      if (($#)) && [[ "$1" != --players ]]; then
        service=$1
        shift
      fi
      parse_players "$@"
      select_project dev
      show_logs "$service"
      ;;
    check)
      (($# == 0)) || die "check takes no arguments"
      run_checks
      ;;
    trial)
      trial "$@"
      ;;
    trial-inner)
      trial_inner "$@"
      ;;
    e2e-server)
      (($# == 0)) || die "e2e-server takes no arguments"
      e2e_server
      ;;
    *) usage; die "unknown command: $command" ;;
  esac
}

main "$@"
