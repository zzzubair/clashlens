# Copy this file to app.env and set mode 600 before deployment.
# Replace every CHANGE_ME value and every example host. Do not commit app.env.
# The deployment refuses to run with a placeholder or with a derived setting
# that the script owns (CLASHLENS_DATABASE_URL, CLASHLENS_OFFICIAL_KEY_FILE,
# CLASHLENS_OFFICIAL_PROXY_URL, inline API-key values, global Top-200
# enablement).

# PostgreSQL runs only on the private Podman network and has no published
# port. POSTGRES_USER is the admin role that applies migrations. Each of the
# three runtime roles below uses its own password; the deployment sets and
# rotates those role passwords through admin psql stdin, never through
# command arguments or logs.
POSTGRES_DB=clashlens
POSTGRES_USER=clashlens
POSTGRES_PASSWORD=CHANGE_ME
CLASHLENS_COLLECTOR_DB_PASSWORD=CHANGE_ME
CLASHLENS_WORKER_DB_PASSWORD=CHANGE_ME
CLASHLENS_API_DB_PASSWORD=CHANGE_ME

# External S3-compatible raw-evidence archive. Do not select a provider here.
# The collector uses its own read-write archive credential pair; the Python
# worker uses a separate read-only pair and never receives the collector pair.
CLASHLENS_ARCHIVE_ENDPOINT=archive.example.invalid:443
CLASHLENS_ARCHIVE_SECURE=true
CLASHLENS_ARCHIVE_BUCKET=clashlens-evidence
CLASHLENS_ARCHIVE_ACCESS_KEY=CHANGE_ME
CLASHLENS_ARCHIVE_SECRET_KEY=CHANGE_ME
CLASHLENS_WORKER_ARCHIVE_ACCESS_KEY=CHANGE_ME
CLASHLENS_WORKER_ARCHIVE_SECRET_KEY=CHANGE_ME

# Official API. The origin stays HTTPS. The fixed-egress proxy URL is
# required; replace the example host with the real restricted CONNECT proxy
# when the API keys allowlist a separate host's fixed public IP.
CLASHLENS_OFFICIAL_API_ORIGIN=https://api.clashofclans.com
CLASHLENS_OFFICIAL_API_PROXY_URL=http://TAILSCALE_PROXY_IP:3128

# Official API key files live on the host under CLASHLENS_API_KEY_HOST_DIR,
# one file per label, each with mode 600. The deployment copies them into
# rootless Podman file secrets and mounts them at the listed /run/secrets
# paths. Create four normal-key files and one interactive-key file outside
# this repository. The single interactive key file also backs the private
# API's official token-verification calls; the API receives it only as a
# mounted file path.
CLASHLENS_API_KEY_HOST_DIR=/etc/clashlens/secrets
CLASHLENS_NORMAL_API_KEY_FILES=normal-1=/run/secrets/clashlens-normal-1,normal-2=/run/secrets/clashlens-normal-2,normal-3=/run/secrets/clashlens-normal-3,normal-4=/run/secrets/clashlens-normal-4
CLASHLENS_INTERACTIVE_API_KEY_FILES=interactive-1=/run/secrets/clashlens-interactive-1
CLASHLENS_INTERACTIVE_API_KEY_FILE=/run/secrets/clashlens-interactive-1

# Private API HMAC proof. The API signs its saved-data responses with the
# current secret file and verifies caller proofs against the same file. To
# rotate, set the previous key ID and previous secret file together while
# the old secret is still accepted, then remove them after the proof
# lifetime and clock-skew allowance have passed.
CLASHLENS_HMAC_CALLER=typescript-website
CLASHLENS_HMAC_KEY_ID=current
CLASHLENS_HMAC_SECRET_FILE=/run/secrets/clashlens-hmac-current
# CLASHLENS_HMAC_PREVIOUS_KEY_ID=previous
# CLASHLENS_HMAC_PREVIOUS_SECRET_FILE=/run/secrets/clashlens-hmac-previous

# Browser login (Phase 1: Google and Discord). The website starts with login
# disabled when none of these are set. A partial configuration is rejected
# before any container changes. Client secrets and the browser session key
# live as protected mode-600 files under CLASHLENS_API_KEY_HOST_DIR; only
# non-secret client IDs and the exact public origin are plain settings.
# CLASHLENS_PUBLIC_ORIGIN must be the exact https origin users visit.
# CLASHLENS_LOGIN_SECRET_FILE holds exactly 32 bytes of high-entropy key
# material (for example: openssl rand -base64 24 | head -c 32).
# CLASHLENS_LOGIN_SECRET_FILE=/run/secrets/clashlens-login-secret-file
# CLASHLENS_PUBLIC_ORIGIN=https://clashlens.example
# CLASHLENS_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# CLASHLENS_GOOGLE_CLIENT_SECRET_FILE=/run/secrets/clashlens-google-client-secret-file
# CLASHLENS_DISCORD_CLIENT_ID=1234567890123456789
# CLASHLENS_DISCORD_CLIENT_SECRET_FILE=/run/secrets/clashlens-discord-client-secret-file

# The Python worker claims leased jobs in bounded batches. Set the lease in
# seconds; the deployment derives the worker stop grace from it.
CLASHLENS_WORKER_LEASE_SECONDS=60

# The worker runs as identical replicas over one shared queue: every replica
# claims any supported Python job. The target-host profile uses one replica;
# durable queue replay provides restart recovery. The valid range is 1-16,
# bounded by the host's 16 hardware threads. Each replica gets its own
# container name and --owner, and the per-worker resource budgets below apply
# per container, so the combined budget is the count times the budget.
CLASHLENS_WORKER_REPLICAS=1

# Bounded in-process Python worker concurrency. Each replica runs up to this
# many parallel job lanes. The default of 1 preserves the sequential behavior
# of a single worker. The measured target-host setting is 12 lanes in one
# replica. The valid range is 1-32, and the deployment rejects any other value
# before changing runtime state.
CLASHLENS_WORKER_CONCURRENCY=12
# Connection pool sizes for each replica's PostgreSQL and archive HTTP pools.
# The target-host profile uses one connection of each kind per lane. The valid
# range for both is 1-64.
CLASHLENS_WORKER_DATABASE_POOL_SIZE=12
CLASHLENS_WORKER_ARCHIVE_POOL_SIZE=12

# Explicit per-role resource budgets. There is no chosen default: the
# maintainer must select measured values for this host and fill every
# setting. Memory accepts an optional b/k/m/g/t suffix.
CLASHLENS_POSTGRES_MEMORY=CHANGE_ME
CLASHLENS_POSTGRES_SHM_SIZE=CHANGE_ME
CLASHLENS_POSTGRES_CPUS=CHANGE_ME
CLASHLENS_POSTGRES_PIDS=CHANGE_ME
CLASHLENS_COLLECTOR_MEMORY=CHANGE_ME
CLASHLENS_COLLECTOR_CPUS=CHANGE_ME
CLASHLENS_COLLECTOR_PIDS=CHANGE_ME
CLASHLENS_API_MEMORY=CHANGE_ME
CLASHLENS_API_CPUS=CHANGE_ME
CLASHLENS_API_PIDS=CHANGE_ME
CLASHLENS_WORKER_MEMORY=CHANGE_ME
CLASHLENS_WORKER_CPUS=CHANGE_ME
CLASHLENS_WORKER_PIDS=CHANGE_ME
CLASHLENS_WEBSITE_MEMORY=CHANGE_ME
CLASHLENS_WEBSITE_CPUS=CHANGE_ME
CLASHLENS_WEBSITE_PIDS=CHANGE_ME

# The website publishes only this beta ingress port. Set the host to 127.0.0.1,
# 0.0.0.0, or a plain IPv4 address. No hosted service is configured.
CLASHLENS_WEBSITE_HOST=127.0.0.1
CLASHLENS_WEBSITE_PORT=3000

# The host publishes only the collector health endpoint on localhost. The
# private Python API has no published port; callers reach it through the
# private network alias python-api:8000.
CLASHLENS_HEALTH_HOST=127.0.0.1
CLASHLENS_HEALTH_PORT=8081

# Optional names and image tags. These do not publish database, archive, or
# API ports. CLASHLENS_PYTHON_IMAGE selects the single Python image; the API
# and worker replicas run from it with different commands.
# CLASHLENS_PYTHON_WORKER_CONTAINER is the worker name base; replicas are
# named <base>-1 through <base>-N where N is CLASHLENS_WORKER_REPLICAS.
CLASHLENS_PODMAN_NETWORK=clashlens-private
CLASHLENS_PODMAN_VOLUME=clashlens-postgres-data
CLASHLENS_POSTGRES_CONTAINER=clashlens-postgres
CLASHLENS_COLLECTOR_CONTAINER=clashlens-collector
CLASHLENS_PYTHON_API_CONTAINER=clashlens-python-api
CLASHLENS_PYTHON_WORKER_CONTAINER=clashlens-python-worker
CLASHLENS_WEBSITE_CONTAINER=clashlens-website
CLASHLENS_POSTGRES_IMAGE=docker.io/library/postgres:17-alpine
CLASHLENS_COLLECTOR_IMAGE=localhost/clashlens-collector:deployment
CLASHLENS_PYTHON_IMAGE=localhost/clashlens-python:deployment
CLASHLENS_WEBSITE_IMAGE=localhost/clashlens-website:deployment

# Optional non-secret collector tuning. These pass through to the collector
# process inside the container.
# The collector PostgreSQL pool is explicitly bounded from 1 to 64. The safe
# default is 16. The measured target-host stage uses 32 connections and
# 8 workers per key: four normal keys provide 32 normal request workers, while
# the interactive workers share the same database pool.
CLASHLENS_COLLECTOR_DATABASE_POOL_SIZE=32
# CLASHLENS_POLL_CYCLE=5m
# CLASHLENS_REQUESTS_PER_SECOND_PER_KEY=30
# CLASHLENS_WORKERS_PER_KEY=8
