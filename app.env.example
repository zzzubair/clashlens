# Copy to app.env, replace every CHANGE_ME value, and run chmod 600 app.env.
# ./ops reads this file without executing it. Secrets are copied into Podman's
# private secret store and do not appear in generated unit files or commands.

# PostgreSQL is private. The admin password initializes a new volume and is
# rotated on each up before short-lived migration/recovery use. The three
# long-running services each receive a narrower runtime role.
POSTGRES_DB=clashlens
POSTGRES_USER=clashlens
POSTGRES_PASSWORD=CHANGE_ME
CLASHLENS_COLLECTOR_DB_PASSWORD=CHANGE_ME
CLASHLENS_WORKER_DB_PASSWORD=CHANGE_ME
CLASHLENS_API_DB_PASSWORD=CHANGE_ME

# Production Scaleway raw-response archive. The collector credential may create
# immutable objects and read back the marker or one exact object for proof; the
# worker gets a separate read-only credential. Runtime credentials must not
# list, delete, overwrite, or broadly browse objects.
CLASHLENS_ARCHIVE_ENDPOINT=s3.nl-ams.scw.cloud
CLASHLENS_ARCHIVE_SECURE=true
CLASHLENS_ARCHIVE_REGION=nl-ams
CLASHLENS_ARCHIVE_INSTANCE_ID=CHANGE_ME
CLASHLENS_ARCHIVE_MARKER_KEY=clashlens/archive-instance.json
CLASHLENS_ARCHIVE_MARKER_HASH=CHANGE_ME
CLASHLENS_ARCHIVE_MARKER_PAYLOAD_VERSION=v1
CLASHLENS_ARCHIVE_BUCKET=clashlens-raw-evidence
CLASHLENS_ARCHIVE_ACCESS_KEY=CHANGE_ME
CLASHLENS_ARCHIVE_SECRET_KEY=CHANGE_ME
CLASHLENS_WORKER_ARCHIVE_ACCESS_KEY=CHANGE_ME
CLASHLENS_WORKER_ARCHIVE_SECRET_KEY=CHANGE_ME

# Enable after preparing the separate mode-600 R2 credential file and approving
# deployment. Use a new prefix for every new PostgreSQL cluster.
CLASHLENS_BACKUP_ENABLED=false
# CLASHLENS_BACKUP_ENDPOINT=https://ACCOUNT_ID.eu.r2.cloudflarestorage.com
# CLASHLENS_BACKUP_PREFIX=s3://clashlens-pg-backup/rogue-pg18
# CLASHLENS_BACKUP_CREDENTIAL_FILE=/srv/clashlens-secrets/clashlens-backup-r2.env

# Private operator alerts. The file must belong to the deployment user with
# mode 600 and contain only the Discord webhook URL. Never put the URL here.
# Defaults to CLASHLENS_API_KEY_HOST_DIR/clashlens-discord-alert-webhook.
# CLASHLENS_DISCORD_ALERT_WEBHOOK_FILE=/srv/clashlens-secrets/clashlens-discord-alert-webhook

# Bounded local spool. Pre-create this dedicated absolute path, owned by the
# deployment user with mode 700. It must not overlap the user's home, checkout,
# ops state/unit directories, or secret directory. ./ops down retains it.
CLASHLENS_SPOOL_ROOT=/srv/clashlens-data/spool
CLASHLENS_SPOOL_MAX_BYTES=17179869184
CLASHLENS_SPOOL_MAX_OBJECTS=1000000
CLASHLENS_SPOOL_FREE_SPACE_FLOOR=1073741824
CLASHLENS_SPOOL_FREE_INODE_FLOOR=10000
CLASHLENS_MAX_BODY_BYTES=4194304

# Official HTTPS API origin. Four regular key files and one interactive key
# file must exist under the directory below with mode 600 and these exact names:
# clashlens-normal-1 .. clashlens-normal-4, clashlens-interactive-1.
CLASHLENS_OFFICIAL_API_ORIGIN=https://api.clashofclans.com
CLASHLENS_API_KEY_HOST_DIR=/srv/clashlens-secrets

# REQUIRED relay origin; see docs/deployment.md#production-configuration.
CLASHLENS_OFFICIAL_API_PROXY_URL=http://egress-proxy.example.invalid:3128

# The HMAC file signs private website/API traffic. Its value names a source
# file under CLASHLENS_API_KEY_HOST_DIR; the container path stays fixed.
CLASHLENS_HMAC_SECRET_FILE=/run/secrets/clashlens-hmac-current
CLASHLENS_HMAC_CALLER=typescript-website
CLASHLENS_HMAC_KEY_ID=current
# For rotation, set both lines, deploy the new current key, wait longer than
# the proof lifetime and clock-skew allowance, then remove the previous pair.
# CLASHLENS_HMAC_PREVIOUS_KEY_ID=previous
# CLASHLENS_HMAC_PREVIOUS_SECRET_FILE=/run/secrets/clashlens-hmac-previous

# Login is disabled when this whole block is absent. Going live with real
# OAuth credentials is after issue #110 and requires separate approval.
# CLASHLENS_PUBLIC_ORIGIN=https://clashlens.example
# CLASHLENS_LOGIN_SECRET_FILE=/run/secrets/clashlens-login-secret
# CLASHLENS_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# CLASHLENS_GOOGLE_CLIENT_SECRET_FILE=/run/secrets/clashlens-google-client-secret
# CLASHLENS_DISCORD_CLIENT_ID=1234567890123456789
# CLASHLENS_DISCORD_CLIENT_SECRET_FILE=/run/secrets/clashlens-discord-client-secret

# Issue #110 fixes production discovery off. Keep the global Top-200 request
# off until real collection is authorized (backups and alerts proven).
CLASHLENS_PLAYER_DISCOVERY_ENABLED=false
CLASHLENS_GLOBAL_RANKINGS_ENABLED=false
# Enable after the October 5 manual recheck, for the October 12 weekly pass.
CLASHLENS_ENABLE_WEEKLY_ELIGIBILITY=false

# One worker process uses 12 bounded lanes and matching database/archive pools.
CLASHLENS_WORKER_LEASE_SECONDS=60
CLASHLENS_WORKER_CONCURRENCY=12
CLASHLENS_WORKER_DATABASE_POOL_SIZE=12
CLASHLENS_WORKER_ARCHIVE_POOL_SIZE=12

# Explicit caps for the 16 GiB Fedora host. The combined memory ceiling is
# 12 GiB; Podman/systemd and the host retain the remaining 4 GiB.
CLASHLENS_POSTGRES_MEMORY=4g
CLASHLENS_POSTGRES_SHM_SIZE=1g
CLASHLENS_POSTGRES_CPUS=4
CLASHLENS_POSTGRES_PIDS=512
CLASHLENS_COLLECTOR_MEMORY=2g
CLASHLENS_COLLECTOR_CPUS=4
CLASHLENS_COLLECTOR_PIDS=512
CLASHLENS_API_MEMORY=1g
CLASHLENS_API_CPUS=2
CLASHLENS_API_PIDS=256
CLASHLENS_WORKER_MEMORY=4g
CLASHLENS_WORKER_CPUS=6
CLASHLENS_WORKER_PIDS=512
CLASHLENS_WEBSITE_MEMORY=1g
CLASHLENS_WEBSITE_CPUS=2
CLASHLENS_WEBSITE_PIDS=256

# Only these two loopback ports are published: website and collector health.
CLASHLENS_WEBSITE_PORT=3000
CLASHLENS_HEALTH_PORT=8081

# Unset: trust CF-Connecting-IP only from the pod's fixed address 10.89.14.2,
# where every connection to the loopback website port appears from. Keep that
# port reachable only by a local proxy behind Cloudflare Tunnel. Set it empty to
# trust no forwarded visitor address, or to another exact peer IP.
# Upgrade: replace an old 10.89.* pod address with 10.89.14.2 or remove the line.
# If an older example left it empty, make the same update to enable per-visitor
# Refresh allowances. An explicit empty value is preserved.
# CLASHLENS_TRUSTED_PROXY_IP=
