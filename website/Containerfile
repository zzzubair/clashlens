# Base images are pinned by digest; the tag each one was taken from is noted
# above it. Update both together.
# node:24.22.1-bookworm-slim
FROM docker.io/library/node@sha256:be8204d4bd327363357f532187b752ff62759c31bedf98e9e18fc08c9cbd605c AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN npm run build:verify

FROM build AS fixtures

CMD ["node", "./tests/fixtures/login-provider.ts"]

FROM build AS check

WORKDIR /
RUN mv /app /website
WORKDIR /website
RUN npx playwright install --with-deps chromium webkit
ENV CLASHLENS_E2E_EXTERNAL_STACK=1
CMD ["sh", "-c", "npm test && npm run build:verify && npx playwright test"]

# node:24.22.1-bookworm-slim
FROM docker.io/library/node@sha256:be8204d4bd327363357f532187b752ff62759c31bedf98e9e18fc08c9cbd605c AS runtime

ENV NODE_ENV=production \
    CLASHLENS_PYTHON_HMAC_SECRET_FILE=/run/secrets/clashlens-python-hmac
WORKDIR /app
COPY --from=build /app/package.json /app/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --from=build /app/build ./build
COPY --from=build /app/server.ts ./server.ts
COPY --from=build /app/app/server/public-origin.server.ts ./app/server/public-origin.server.ts

USER node
EXPOSE 3000
CMD ["node", "./server.ts"]
