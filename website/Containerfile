FROM docker.io/library/node:24.19.0-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN npm run build:verify

FROM build AS fixtures

CMD ["node", "./tests/fixtures/login-provider.ts"]

FROM build AS check

RUN npx playwright install --with-deps chromium
ENV CLASHLENS_E2E_EXTERNAL_STACK=1
CMD ["sh", "-c", "npm test && npm run build:verify && npx playwright test"]

FROM docker.io/library/node:24.19.0-bookworm-slim AS runtime

ENV NODE_ENV=production \
    CLASHLENS_PYTHON_HMAC_SECRET_FILE=/run/secrets/clashlens-python-hmac
WORKDIR /app
COPY --from=build /app/package.json /app/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --from=build /app/build ./build

USER node
EXPOSE 3000
CMD ["node", "./node_modules/@react-router/serve/bin.cjs", "./build/server/index.js"]
