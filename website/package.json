{
  "name": "@clash-lens/website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "build:verify": "npm run build && npm run check:browser-assets",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint app tests scripts *.ts *.js --max-warnings=0",
    "format": "prettier --check app tests scripts *.ts *.js *.json *.md",
    "format:write": "prettier --write app tests scripts *.ts *.js *.json *.md",
    "test:unit": "vitest run",
    "test:e2e": "npm run build:verify && playwright test",
    "test": "npm run typecheck && npm run lint && npm run format && npm run test:unit",
    "check:browser-assets": "node ./scripts/check-browser-assets.mjs",
    "fixture": "python3 ./fixture_server.py",
    "podman:build": "podman build --file Containerfile --tag clashlens-website:prototype ."
  },
  "dependencies": {
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "isbot": "5.1.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@react-router/dev": "8.3.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.0",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
