# The Node server reads these values at runtime. Do not commit secret values.
CLASHLENS_PYTHON_API_URL=http://python-private-api:8000
CLASHLENS_PYTHON_HMAC_CALLER=typescript-website
CLASHLENS_PYTHON_HMAC_KEY_ID=current
CLASHLENS_PYTHON_HMAC_SECRET_FILE=/run/secrets/clashlens-python-hmac
# Set only when a trusted reverse proxy overwrites X-Forwarded-For.
CLASHLENS_TRUST_PROXY=false

# Google login is optional. Public pages work when it is false.
CLASHLENS_LOGIN_ENABLED=false
CLASHLENS_PUBLIC_ORIGIN=https://clashlens.example
CLASHLENS_GOOGLE_CLIENT_ID=replace-with-google-client-id
CLASHLENS_GOOGLE_CLIENT_SECRET_FILE=/run/secrets/clashlens-google-client-secret
CLASHLENS_LOGIN_SECRET_FILE=/run/secrets/clashlens-browser-login
# Non-production local OIDC tests only. Production rejects this override.
# CLASHLENS_GOOGLE_ISSUER_URL=http://127.0.0.1:8011
