# The Node server reads these values at runtime. Do not commit secret values.
CLASHLENS_PYTHON_API_URL=http://python-private-api:8000
CLASHLENS_PYTHON_HMAC_CALLER=typescript-website
CLASHLENS_PYTHON_HMAC_KEY_ID=current
CLASHLENS_PYTHON_HMAC_SECRET_FILE=/run/secrets/clashlens-python-hmac
# Set only when a trusted reverse proxy overwrites X-Forwarded-For.
CLASHLENS_TRUST_PROXY=false
