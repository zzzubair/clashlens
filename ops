validate_mode600_file() {
  local file=$1
  [[ "$file" == /* && "$file" != */ ]] || die "secret path $file must be an absolute file"
  validate_directory_ancestry "${file%/*}"
  [[ -f "$file" && ! -L "$file" && -r "$file" ]] || die "missing or unsafe secret file $file"
  [[ "$(stat -c '%a' "$file")" == 600 ]] || die "$file must have mode 600"
}

read_secret_value() {
  local file=$1 lines
  validate_mode600_file "$file"
  lines=$(wc -l < "$file")
  (( lines <= 1 )) || die "$file must contain exactly one value"
  SECRET_VALUE=$(cat -- "$file") || die "cannot read $file"
  [[ -n "$SECRET_VALUE" && "$SECRET_VALUE" != *$'\n'* && "$SECRET_VALUE" != *$'\r'* ]] || die "$file must contain exactly one value"
}

validate_production_secret_files() {
  local secret_dir name file value
  secret_dir=$(setting CLASHLENS_API_KEY_HOST_DIR)
  for name in clashlens-normal-1 clashlens-normal-2 clashlens-normal-3 clashlens-normal-4 clashlens-interactive-1; do
    file="$secret_dir/$name"
    read_secret_value "$file"
    value=$SECRET_VALUE
    [[ -n "$value" && "$value" != *[[:space:],=]* ]] || die "$file contains an invalid API key"
  done
  file="$secret_dir/${CONFIG[CLASHLENS_HMAC_SECRET_FILE]##*/}"
  read_secret_value "$file"
  [[ "$SECRET_VALUE" =~ ^[A-Za-z0-9_-]{43}$ ]] || die "$file must contain one 32-byte unpadded base64url HMAC key"
  if [[ -n "$(setting CLASHLENS_HMAC_PREVIOUS_SECRET_FILE)" ]]; then
    file="$secret_dir/${CONFIG[CLASHLENS_HMAC_PREVIOUS_SECRET_FILE]##*/}"
    read_secret_value "$file"
    [[ "$SECRET_VALUE" =~ ^[A-Za-z0-9_-]{43}$ ]] || die "$file must contain one 32-byte unpadded base64url HMAC key"
  fi
  if [[ -n "$(setting CLASHLENS_PUBLIC_ORIGIN)" ]]; then
    file="$secret_dir/${CONFIG[CLASHLENS_LOGIN_SECRET_FILE]##*/}"
    read_secret_value "$file"
    [[ "$SECRET_VALUE" =~ ^[A-Za-z0-9_-]{43}$ ]] || die "$file must contain one 32-byte unpadded base64url login key"
    for name in CLASHLENS_GOOGLE_CLIENT_SECRET_FILE CLASHLENS_DISCORD_CLIENT_SECRET_FILE; do
      file="$secret_dir/${CONFIG[$name]##*/}"
      read_secret_value "$file"
      [[ "${#SECRET_VALUE}" -le 512 && "$SECRET_VALUE" != *[[:space:]]* && "$SECRET_VALUE" != CHANGE_ME && "$SECRET_VALUE" != REPLACE_ME ]] || die "$file contains an invalid provider secret"
    done
  fi
  unset SECRET_VALUE
}

replace_file_secret() {
  local name=$1 file=$2
  validate_mode600_file "$file"
  guard_resource secret "$name"
  "$PODMAN_BIN" secret create --replace --label org.clashlens.managed=ops "$name" "$file" >/dev/null
}

prepare_secrets() {
  if backup_enabled; then
    replace_secret clashlens-walg-config "$(backup_config_json)"
  fi
  replace_secret clashlens-postgres-password "${CONFIG[POSTGRES_PASSWORD]}"
  replace_secret clashlens-collector-database-url "postgresql://clashlens_collector:${CONFIG[CLASHLENS_COLLECTOR_DB_PASSWORD]}@127.0.0.1:5432/$POSTGRES_DB?sslmode=disable"
  replace_secret clashlens-worker-database-url "postgresql://clashlens_python_worker:${CONFIG[CLASHLENS_WORKER_DB_PASSWORD]}@127.0.0.1:5432/$POSTGRES_DB?sslmode=disable"
  replace_secret clashlens-api-database-url "postgresql://clashlens_python_api:${CONFIG[CLASHLENS_API_DB_PASSWORD]}@127.0.0.1:5432/$POSTGRES_DB?sslmode=disable"
  if [[ "$MODE" == fixture ]]; then
    replace_secret clashlens-collector-archive-access-key development
    replace_secret clashlens-collector-archive-secret-key development
    replace_secret clashlens-worker-archive-access-key development
    replace_secret clashlens-worker-archive-secret-key development
    replace_secret clashlens-normal-api-keys normal-1=dev-normal-key-1,normal-2=dev-normal-key-2,normal-3=dev-normal-key-3,normal-4=dev-normal-key-4
    replace_secret clashlens-interactive-api-keys interactive-1=dev-interactive-key
    replace_secret clashlens-interactive-1 dev-interactive-key
    replace_secret clashlens-hmac-current AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8
    replace_secret clashlens-hmac-previous disabled
    replace_secret clashlens-login-secret QEFCQ0RFRkdISUpLTE1OT1BRUlNUVVZXWFlaW1xdXl8
    replace_secret clashlens-google-client-secret clashlens-browser-test-secret
    replace_secret clashlens-discord-client-secret discord-browser-test-secret
  else
    replace_secret clashlens-collector-archive-access-key "$(setting CLASHLENS_ARCHIVE_ACCESS_KEY)"
    replace_secret clashlens-collector-archive-secret-key "$(setting CLASHLENS_ARCHIVE_SECRET_KEY)"
    replace_secret clashlens-worker-archive-access-key "$(setting CLASHLENS_WORKER_ARCHIVE_ACCESS_KEY)"
    replace_secret clashlens-worker-archive-secret-key "$(setting CLASHLENS_WORKER_ARCHIVE_SECRET_KEY)"
    local secret_dir name key_value normal_keys= interactive_key
    secret_dir=$(setting CLASHLENS_API_KEY_HOST_DIR)
    for name in clashlens-normal-1 clashlens-normal-2 clashlens-normal-3 clashlens-normal-4; do
      IFS= read -r key_value < "$secret_dir/$name" || true
      [[ -n "$key_value" && "$key_value" != *[[:space:],=]* ]] || die "$secret_dir/$name contains an invalid API key"
      [[ -z "$normal_keys" ]] || normal_keys+=,
      normal_keys+="${name#clashlens-}=$key_value"
    done
    name=clashlens-interactive-1
    IFS= read -r interactive_key < "$secret_dir/$name" || true
    [[ -n "$interactive_key" && "$interactive_key" != *[[:space:],=]* ]] || die "$secret_dir/$name contains an invalid API key"
    replace_secret clashlens-normal-api-keys "$normal_keys"
    replace_secret clashlens-interactive-api-keys "interactive-1=$interactive_key"
    replace_file_secret clashlens-interactive-1 "$secret_dir/$name"
    replace_file_secret clashlens-hmac-current "$secret_dir/${CONFIG[CLASHLENS_HMAC_SECRET_FILE]##*/}"
    if [[ -n "$(setting CLASHLENS_HMAC_PREVIOUS_KEY_ID)" ]]; then
      replace_file_secret clashlens-hmac-previous "$secret_dir/${CONFIG[CLASHLENS_HMAC_PREVIOUS_SECRET_FILE]##*/}"
    else
      replace_secret clashlens-hmac-previous disabled
    fi
    if [[ -n "$(setting CLASHLENS_PUBLIC_ORIGIN)" ]]; then
      replace_file_secret clashlens-login-secret "$secret_dir/${CONFIG[CLASHLENS_LOGIN_SECRET_FILE]##*/}"
      replace_file_secret clashlens-google-client-secret "$secret_dir/${CONFIG[CLASHLENS_GOOGLE_CLIENT_SECRET_FILE]##*/}"
      replace_file_secret clashlens-discord-client-secret "$secret_dir/${CONFIG[CLASHLENS_DISCORD_CLIENT_SECRET_FILE]##*/}"
    else
      replace_secret clashlens-login-secret disabled
      replace_secret clashlens-google-client-secret disabled
      replace_secret clashlens-discord-client-secret disabled
    fi
  fi
}

wait_postgres() {
  local attempt
  for attempt in $(seq 1 90); do
    "$PODMAN_BIN" exec "$PREFIX-postgres" pg_isready -q -U "$POSTGRES_USER" -d "$POSTGRES_DB" >/dev/null 2>&1 && return
    sleep 1
  done
  die "PostgreSQL did not become ready; run ./ops logs postgres"
}

psql_exec() {
  "$PODMAN_BIN" exec --interactive "$PREFIX-postgres" psql --quiet --set ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" "$@"
}

psql_exec_sensitive() {
  local options='-c log_statement=none -c log_min_error_statement=panic -c pg_stat_statements.track_utility=off'
  "$PODMAN_BIN" exec --interactive --env "PGOPTIONS=$options" "$PREFIX-postgres" \
    psql --quiet --set ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" "$@"
}

sql_literal() {
  local value=${1//\'/\'\'}
  printf "'%s'" "$value"
}

apply_migrations() {
  local migration base prefix version exists
  exists=$(psql_exec --tuples-only --no-align --command "SELECT to_regclass('public.clash_lens_schema_migrations') IS NOT NULL")
  if [[ "$(trim "$exists")" != t ]]; then psql_exec < "$ROOT/deploy/migrations/0001_collector.sql"; fi
  for migration in "$ROOT"/deploy/migrations/*.sql; do
    [[ "${migration##*/}" == 0001_collector.sql ]] && continue
    base=${migration##*/}; prefix=${base%%_*}; version=$((10#$prefix))
    exists=$(psql_exec --tuples-only --no-align --command "SELECT EXISTS (SELECT 1 FROM clash_lens_schema_migrations WHERE version=$version)")
    if [[ "$(trim "$exists")" != t ]]; then
      printf 'Applying %s...\n' "${migration##*/}"
      psql_exec < "$migration"
    fi
  done
}

configure_database() {
  local admin_password collector_password worker_password api_password sql
  admin_password=$(sql_literal "${CONFIG[POSTGRES_PASSWORD]}")
  collector_password=$(sql_literal "${CONFIG[CLASHLENS_COLLECTOR_DB_PASSWORD]}")
  worker_password=$(sql_literal "${CONFIG[CLASHLENS_WORKER_DB_PASSWORD]}")
  api_password=$(sql_literal "${CONFIG[CLASHLENS_API_DB_PASSWORD]}")
  sql="BEGIN; ALTER ROLE \"$POSTGRES_USER\" WITH LOGIN PASSWORD $admin_password;"
  sql+=" ALTER ROLE clashlens_collector WITH LOGIN PASSWORD $collector_password;"
  sql+=" ALTER ROLE clashlens_python_worker WITH LOGIN PASSWORD $worker_password;"
  sql+=" ALTER ROLE clashlens_python_api WITH LOGIN PASSWORD $api_password;"
  sql+=' REVOKE ALL PRIVILEGES ON TABLE python_processing_jobs FROM clashlens_python_worker;'
  sql+=' GRANT SELECT (id, lease_generation) ON TABLE python_processing_jobs TO clashlens_python_worker; COMMIT;'
  printf '%s\n' "$sql" | psql_exec_sensitive
  unset admin_password collector_password worker_password api_password sql
  local endpoint region bucket instance marker_key marker_hash marker_version
  if [[ "$MODE" == fixture ]]; then endpoint=127.0.0.1:9000; region=us-east-1; bucket=evidence; instance=development; marker_key=clashlens/archive-instance.json; marker_hash=16d586e6c52a90aed1fed855fd03e9ce7257319cfcb5b824cb52015989b52192; marker_version=v1
  else endpoint=$(setting CLASHLENS_ARCHIVE_ENDPOINT); region=$(setting CLASHLENS_ARCHIVE_REGION); bucket=$(setting CLASHLENS_ARCHIVE_BUCKET); instance=$(setting CLASHLENS_ARCHIVE_INSTANCE_ID); marker_key=$(setting CLASHLENS_ARCHIVE_MARKER_KEY); marker_hash=$(setting CLASHLENS_ARCHIVE_MARKER_HASH); marker_version=$(setting CLASHLENS_ARCHIVE_MARKER_PAYLOAD_VERSION); fi
  local q_endpoint q_region q_bucket q_instance q_marker_key q_marker_hash q_marker_version
  q_endpoint=$(sql_literal "$endpoint"); q_region=$(sql_literal "$region"); q_bucket=$(sql_literal "$bucket"); q_instance=$(sql_literal "$instance")
  q_marker_key=$(sql_literal "$marker_key"); q_marker_hash=$(sql_literal "$marker_hash"); q_marker_version=$(sql_literal "$marker_version")
  printf '%s\n' "INSERT INTO archive_instances (instance_id, endpoint, region, bucket, marker_key, marker_hash, marker_payload_version) VALUES ($q_instance, $q_endpoint, $q_region, $q_bucket, $q_marker_key, $q_marker_hash, $q_marker_version) ON CONFLICT (instance_id) DO NOTHING;" | psql_exec
  local archive_matches
  archive_matches=$(printf '%s\n' "SELECT count(*) FROM archive_instances WHERE instance_id=$q_instance AND endpoint=$q_endpoint AND region=$q_region AND bucket=$q_bucket AND marker_key=$q_marker_key AND marker_hash=$q_marker_hash AND marker_payload_version=$q_marker_version;" | psql_exec --tuples-only --no-align)
  [[ "$(trim "$archive_matches")" == 1 ]] || die "archive instance contract differs from retained database"
}

admin_database_url() {
  printf 'postgresql://%s:%s@127.0.0.1:5432/%s?sslmode=disable' "$POSTGRES_USER" "${CONFIG[POSTGRES_PASSWORD]}" "$POSTGRES_DB"
}

create_admin_secret() {
  cleanup_stale_admin_state
  printf '%s' "$(admin_database_url)" | "$PODMAN_BIN" secret create --label org.clashlens.managed=ops --label org.clashlens.purpose=transient-admin clashlens-init-database-url - >/dev/null
  ADMIN_SECRET_ACTIVE=true
}

run_with_admin_database() {
  local image=$1
  shift
  create_admin_secret
  set +e
  "$PODMAN_BIN" run --rm --name "$PREFIX-admin-operation" --label org.clashlens.managed=ops --label org.clashlens.purpose=transient-admin --pod "$PREFIX-pod" \
    --secret clashlens-init-database-url,type=mount,target=/run/secrets/database-url,uid=10001,gid=10001,mode=0400 \
    "$image" "$@"
  local result=$?
  set -e
  cleanup_admin_secret || result=1
  return "$result"
}

bootstrap_fixture() {
  local manifest digest result receipt_matches
  manifest="$STATE_DIR/fixture/cohort-200.txt"; result="$STATE_DIR/fixture/bootstrap.json"
  "$PODMAN_BIN" run --rm --pod "$PREFIX-pod" --user 10001:10001 --volume "$STATE_DIR/fixture:/state:Z" "${RELEASE[FIXTURES_IMAGE]}" manifest --players 200 --output /state/cohort-200.txt
  digest=$(sha256sum "$manifest" | cut -d' ' -f1)
  receipt_matches=$(printf '%s\n' "SELECT count(*) FROM population_bootstrap_runs WHERE run_id='ops-fixture-200' AND manifest_sha256='$digest' AND manifest_count=200 AND status='complete' AND players_registered=200 AND discovery_jobs_created=200;" | psql_exec --tuples-only --no-align)
  [[ "$(trim "$receipt_matches")" == 0 ]] || { [[ "$(trim "$receipt_matches")" == 1 ]] && return; die "fixture bootstrap receipt is ambiguous"; }
  [[ ! -e "$result" && ! -L "$result" ]] || die "fixture bootstrap receipt file exists without a matching database receipt"
  create_admin_secret
  set +e
  "$PODMAN_BIN" run --rm --name "$PREFIX-admin-operation" --label org.clashlens.managed=ops --label org.clashlens.purpose=transient-admin --pod "$PREFIX-pod" \
    --secret clashlens-init-database-url,type=mount,target=/run/secrets/database-url,uid=10001,gid=10001,mode=0400 \
    --volume "$STATE_DIR/fixture:/state:Z" "${RELEASE[PYTHON_IMAGE]}" bootstrap-population --database-url-file /run/secrets/database-url \
    --cohort-file /state/cohort-200.txt --expected-sha256 "$digest" --expected-count 200 --run-id ops-fixture-200 --result-file /state/bootstrap.json >/dev/null
  local bootstrap_result=$?
  set -e
  cleanup_admin_secret || bootstrap_result=1
  (( bootstrap_result == 0 )) || return "$bootstrap_result"
}

ensure_linger() {
  local linger
  linger=$($LOGINCTL_BIN show-user "$USER" --property=Linger --value 2>/dev/null || true)
  [[ "$linger" == yes ]] && return
  if [[ $(id -u) == 0 ]]; then "$LOGINCTL_BIN" enable-linger "$USER"; else sudo "$LOGINCTL_BIN" enable-linger "$USER"; fi
  [[ "$($LOGINCTL_BIN show-user "$USER" --property=Linger --value)" == yes ]] || die "could not enable user lingering for reboot survival"
}

stop_units() {
  "$SYSTEMCTL_BIN" --user stop clashlens-backup.timer clashlens-backup.service >/dev/null 2>&1 || true
  "$SYSTEMCTL_BIN" --user disable --now clashlens.target >/dev/null 2>&1 || true
  local unit state
  for unit in clashlens-website clashlens-collector clashlens-api clashlens-worker clashlens-login clashlens-clash-api clashlens-archive clashlens-postgres clashlens-pod clashlens-network clashlens-postgres-volume clashlens-python-api clashlens-python-worker clashlens; do
    "$SYSTEMCTL_BIN" --user stop "$unit.service" >/dev/null 2>&1 || true
  done
  state=$($SYSTEMCTL_BIN --user is-enabled clashlens.target 2>/dev/null || true)
  [[ "$state" != enabled && "$state" != enabled-runtime ]] || die "could not disable clashlens.target"
  for unit in clashlens-website clashlens-worker clashlens-api clashlens-collector clashlens-login clashlens-clash-api clashlens-archive clashlens-postgres clashlens-pod clashlens-network clashlens-postgres-volume clashlens-python-api clashlens-python-worker clashlens; do
    state=$($SYSTEMCTL_BIN --user is-active "$unit.service" 2>/dev/null || true)
    case "$state" in active|activating|deactivating|reloading) die "could not stop $unit.service" ;; esac
  done
}

container_name() {
  local prefix=$1 service=$2
  case "$service" in
    api) printf '%s-python-api' "$prefix" ;;
    worker) printf '%s-python-worker' "$prefix" ;;
    *) printf '%s-%s' "$prefix" "$service" ;;
  esac
}

container_state() {
  "$PODMAN_BIN" inspect --format '{{if and .State.Running (not .State.Paused) (eq .State.Status "running")}}{{if .State.Health}}{{.State.Health.Status}}{{else}}running{{end}}{{else}}{{.State.Status}}{{end}}' "$1" 2>/dev/null || printf absent
}

service_state() {
  local state
  state=$($SYSTEMCTL_BIN --user is-active "clashlens-$1.service" 2>/dev/null || true)
  printf '%s' "${state:-unknown}"
}

wait_stack() {
  local attempt service state unit_state all
  local services=(postgres collector api worker website)
  [[ "$MODE" != fixture ]] || services+=(archive clash-api login)
  for attempt in $(seq 1 120); do
    all=true
    unit_state=$(service_state pod)
    [[ "$unit_state" == active ]] || all=false
    if [[ "$all" == true ]]; then
      for service in "${services[@]}"; do
        unit_state=$(service_state "$service")
        [[ "$unit_state" == active ]] || { all=false; break; }
        state=$(container_state "$(container_name "$PREFIX" "$service")")
        [[ "$state" == healthy || "$state" == running ]] || { all=false; break; }
      done
    fi
    [[ "$all" == true ]] && return
    sleep 1
  done
  status || true
  return 1
}

up_stack() {
  require_host
  load_release
  if [[ "$MODE" == fixture ]]; then load_fixture_config; else load_production_config; fi
  validate_runtime_values
  [[ ! -L "$STATE_DIR/mode" ]] || die "refusing symlink deployment mode file $STATE_DIR/mode"
  if [[ -r "$STATE_DIR/mode" && "$(<"$STATE_DIR/mode")" != "$MODE" ]]; then
    [[ "$($SYSTEMCTL_BIN --user is-active clashlens.target 2>/dev/null || true)" != active ]] || \
      die "run ./ops down before switching deployment modes"
  fi
  guard_generated_units
  guard_existing_resources
  cleanup_stale_admin_state
  ensure_linger
  migrate_legacy_units
  guard_systemd_units
  UP_IN_PROGRESS=true
  stop_units
  mkdir -p "$STATE_DIR"
  local mode_file
  mode_file=$(mktemp "$STATE_DIR/mode.XXXXXX")
  chmod 600 "$mode_file"
  printf '%s\n' "$MODE" > "$mode_file"
  mv -f "$mode_file" "$STATE_DIR/mode"
  write_environment
  prepare_secrets
  render_units
  "$SYSTEMCTL_BIN" --user daemon-reload
  "$SYSTEMCTL_BIN" --user start clashlens-postgres.service
  wait_postgres
  apply_migrations
  configure_database
  if [[ "$MODE" == fixture ]]; then
    "$SYSTEMCTL_BIN" --user start clashlens-archive.service clashlens-clash-api.service clashlens-login.service
    bootstrap_fixture
  fi
  if ! "$SYSTEMCTL_BIN" --user start clashlens.target; then
    stop_units
    die "the stack failed to start; run ./ops logs"
  fi
  if ! wait_stack; then
    stop_units
    die "the stack did not become healthy; run ./ops logs"
  fi
  if ! "$SYSTEMCTL_BIN" --user enable clashlens.target >/dev/null; then
    stop_units
    die "the healthy stack could not be enabled for reboot"
  fi
  promote_active_release
  UP_IN_PROGRESS=false
  printf 'Clash Lens %s is ready at http://127.0.0.1:%s and is enabled after reboot.\n' "$MODE" "$WEBSITE_PORT"
}

current_prefix() {
  [[ ! -L "$STATE_DIR/mode" ]] || die "refusing symlink deployment mode file $STATE_DIR/mode"
  if [[ -r "$STATE_DIR/mode" && "$(<"$STATE_DIR/mode")" == fixture ]]; then printf clashlens-ops-fixture; else printf clashlens; fi
}

prepare_managed_runtime() {
  local service=$1 container actual_image actual_pod expected_pod running
  validate_directory_ancestry "$STATE_DIR"
  validate_directory_ancestry "$QUADLET_DIR"
  validate_directory_ancestry "$USER_UNIT_DIR"
  MANAGED_PREFIX=$(current_prefix)
  if [[ "$MANAGED_PREFIX" == clashlens-ops-fixture ]]; then MODE=fixture; else MODE=production; fi
  load_active_release
  guard_generated_units
  guard_existing_resources
  guard_systemd_units
  container=$(container_name "$MANAGED_PREFIX" "$service")
  actual_image=$($PODMAN_BIN inspect --format '{{.Image}}' "$container" 2>/dev/null) || die "$service is not running"
  actual_image=$(normalize_image_id "$actual_image")
  local expected_image=${RELEASE[PYTHON_IMAGE]}
  [[ "$service" != postgres ]] || expected_image=${RELEASE[POSTGRES_IMAGE]}
  [[ "$actual_image" == "$expected_image" ]] || die "$service is not the pinned release"
  actual_pod=$($PODMAN_BIN inspect --format '{{.Pod}}' "$container" 2>/dev/null) || die "cannot inspect $service pod"
  expected_pod=$($PODMAN_BIN pod inspect --format '{{.Id}}' "$MANAGED_PREFIX-pod" 2>/dev/null) || die "managed pod is absent"
  [[ "$actual_pod" == "$expected_pod" ]] || die "$service is not in the managed pod"
  running=$($PODMAN_BIN inspect --format '{{.State.Running}}' "$container" 2>/dev/null || true)
  [[ "$running" == true ]] || die "$service is not running"
}

status() {
  require_host
  local prefix service state unit_state active result=0 mode
  prefix=$(current_prefix)
  mode=production
  [[ "$prefix" != clashlens ]] && mode=fixture
  active=$($SYSTEMCTL_BIN --user is-active clashlens.target 2>/dev/null || true)
  printf 'stack      %s\n' "${active:-unknown}"
  [[ "$active" == active ]] || result=1
  unit_state=$(service_state pod)
  printf '%-10s %s\n' pod "$unit_state"
  [[ "$unit_state" == active ]] || result=1
  local services=(postgres collector api worker website)
  [[ "$mode" != fixture ]] || services+=(archive clash-api login)
  for service in "${services[@]}"; do
    unit_state=$(service_state "$service")
    state=$(container_state "$(container_name "$prefix" "$service")")
    printf '%-10s %s' "$service" "$state"
    [[ "$unit_state" == active ]] || printf ' (unit %s)' "$unit_state"
    printf '\n'
    [[ "$unit_state" == active && ( "$state" == healthy || "$state" == running ) ]] || result=1
  done
  return "$result"
}

logs() {
  require_host
  local service=${1:-} unit
  if [[ -z "$service" ]]; then
    journalctl --user-unit clashlens.target --user-unit 'clashlens-*.service' --lines 200 --no-pager
    return
  fi
  case "$service" in postgres|collector|api|worker|website|archive|clash-api|login|backup) unit="clashlens-$service.service" ;; *) die "unknown service $service" ;; esac
  shift || true
  journalctl --user-unit "$unit" "$@"
}

exec_service() {
  require_host
  prepare_managed_runtime worker
  "$PODMAN_BIN" exec "$(container_name "$MANAGED_PREFIX" worker)" python -m clashlens.cli queue-status
}

failed_items() {
  require_host
  prepare_managed_runtime worker
  if [[ "$MODE" == fixture ]]; then load_fixture_config; else load_production_config; fi
  run_with_admin_database "${RELEASE[PYTHON_IMAGE]}" failed-items --database-url-file /run/secrets/database-url "$@"
}

backup_enabled() {
  [[ "${MODE:-}" == production && "$(setting CLASHLENS_BACKUP_ENABLED false)" == true ]]
}

validate_backup_config() {
  [[ "$(setting CLASHLENS_BACKUP_ENABLED false)" =~ ^(true|false)$ ]] || die "CLASHLENS_BACKUP_ENABLED must be true or false"
  [[ "$(setting CLASHLENS_BACKUP_ENABLED false)" == true ]] || return 0
  local name
  for name in CLASHLENS_BACKUP_ENDPOINT CLASHLENS_BACKUP_PREFIX CLASHLENS_BACKUP_CREDENTIAL_FILE; do require_setting "$name"; done
  [[ "$(setting CLASHLENS_BACKUP_ENDPOINT)" =~ ^https://[a-f0-9]{32}\.eu\.r2\.cloudflarestorage\.com$ ]] || die "backup endpoint must be the R2 EU endpoint"
  [[ "$(setting CLASHLENS_BACKUP_PREFIX)" =~ ^s3://clashlens-pg-backup/[A-Za-z0-9_-]+$ ]] || die "backup prefix must name a dedicated cluster under s3://clashlens-pg-backup/"
  command -v python3 >/dev/null || die "backup retention requires Fedora python3"
  backup_config_json >/dev/null
}

backup_config_json() {
  local file line key value access= secret=
  file=$(setting CLASHLENS_BACKUP_CREDENTIAL_FILE)
  validate_mode600_file "$file"
  [[ "$(stat -c '%u' "$file")" == "$(id -u)" ]] || die "backup credential file must belong to the service account"
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" ]] && continue
    key=${line%%=*}; value=${line#*=}
    case "$key" in
      AWS_ACCESS_KEY_ID) [[ -z "$access" && "$value" =~ ^[a-f0-9]{32}$ ]] || die "invalid R2 access key ID"; access=$value ;;
      AWS_SECRET_ACCESS_KEY) [[ -z "$secret" && "$value" =~ ^[a-f0-9]{64}$ ]] || die "invalid R2 secret access key"; secret=$value ;;
      *) die "backup credential file must contain only AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY" ;;
    esac
  done < "$file"
  [[ -n "$access" && -n "$secret" ]] || die "backup credential file is incomplete"
  printf '{"AWS_ACCESS_KEY_ID":"%s","AWS_SECRET_ACCESS_KEY":"%s","AWS_ENDPOINT":"%s","AWS_REGION":"auto","AWS_S3_FORCE_PATH_STYLE":"true","WALG_S3_PREFIX":"%s","WALG_COMPRESSION_METHOD":"lz4","WALG_UPLOAD_CONCURRENCY":"2","WALG_DOWNLOAD_CONCURRENCY":"2","WALG_PREVENT_WAL_OVERWRITE":"true"}' \
    "$access" "$secret" "$(setting CLASHLENS_BACKUP_ENDPOINT)" "$(setting CLASHLENS_BACKUP_PREFIX)"
}

prepare_backup() {
  require_host
  prepare_managed_runtime postgres
  [[ "$MODE" == production ]] || die "backups are unavailable in fixture mode"
  "$PODMAN_BIN" exec --user postgres "$MANAGED_PREFIX-postgres" test -r /run/secrets/walg.json || die "backups are not configured on the running release"
}

wal_g() {
  "$PODMAN_BIN" exec --user postgres "$MANAGED_PREFIX-postgres" wal-g --config /run/secrets/walg.json "$@"
}

backup() {
  prepare_backup
  wal_g backup-push /var/lib/postgresql/data/pgdata
  backup_prune --apply
  printf 'Base backup uploaded and seven-day retention applied.\n'
}

backup_status() {
  prepare_backup
  "$SYSTEMCTL_BIN" --user is-active clashlens-backup.timer
  [[ "$(service_state backup)" != failed ]] || die "last scheduled backup failed; run ./ops logs backup"
  wal_g backup-list --detail --json | python3 -c '
import datetime as dt, json, sys
rows = json.load(sys.stdin)
if not rows:
    sys.exit("No completed backup in remote storage")
times = [dt.datetime.fromisoformat(r["finish_time"].replace("Z", "+00:00")) for r in rows]
now = dt.datetime.now(dt.timezone.utc)
age = (now - max(times)).total_seconds()
print(f"Remote base backups: {len(rows)}; newest age: {age:.0f} seconds")
print(f"Oldest completed base backup: {min(times).isoformat()}")
if min(times) > now - dt.timedelta(days=7):
    print("Seven-day window is still warming up")
if not 0 <= age <= 691200:
    sys.exit("Latest remote base backup is stale or has an invalid time")
'
  "$PODMAN_BIN" exec --user postgres "$MANAGED_PREFIX-postgres" sh -ec '
    test "$(psql -X -At -v ON_ERROR_STOP=1 -c "SHOW archive_mode")" = on
    stale=$(find "$PGDATA/pg_wal/archive_status" -name "*.ready" -mmin +10 -print)
    test -z "$stale" || { echo "WAL upload overdue by more than 10 minutes"; exit 1; }
    psql -X -v ON_ERROR_STOP=1 -c "SELECT archived_count,last_archived_time,failed_count,last_failed_time FROM pg_stat_archiver"
  '
}

backup_prune() {
  local apply= anchor
  if (($#)); then
    [[ $# == 1 && "$1" == --apply ]] || die "backup-prune accepts only --apply"
    apply=--confirm
  fi
  prepare_backup
  # Keep the full backup completed before the recovery boundary and every
  # later backup/WAL. Extra manual backups must not shorten the promised window.
  anchor=$(wal_g backup-list --detail --json | python3 -c '
import datetime as dt, json, re, sys
now = dt.datetime.now(dt.timezone.utc)
cutoff = now - dt.timedelta(days=7, hours=1)
rows = json.load(sys.stdin)
candidates = []
for row in rows:
    name = row["backup_name"]
    if not re.fullmatch(r"base_[0-9A-F]{24}", name):
        sys.exit("Retention refuses unexpected or incremental backup names")
    start = dt.datetime.fromisoformat(row["start_time"].replace("Z", "+00:00"))
    finish = dt.datetime.fromisoformat(row["finish_time"].replace("Z", "+00:00"))
    if not start.tzinfo or not finish.tzinfo or not dt.datetime(2020,1,1,tzinfo=dt.timezone.utc) < start <= finish <= now:
        sys.exit("Retention refuses invalid backup times")
    if finish <= cutoff:
        candidates.append((start, name))
if candidates:
    print(max(candidates)[1])
') || die "could not choose a safe retention boundary"
  [[ -n "$anchor" ]] || { printf 'No backup predates the seven-day window; nothing will be deleted.\n'; return; }
  wal_g delete before "$anchor" --use-sentinel-time ${apply:+"$apply"}
}

command=${1:-}
[[ -n "$command" ]] || { usage; exit 2; }
shift
case "$command" in
  build) acquire_mutation_lock; parse_mode "$@"; build_release ;;
  up) acquire_mutation_lock; parse_mode "$@"; up_stack ;;
  down)
    (($# == 0)) || die "down takes no arguments"
    acquire_mutation_lock
    require_host
    validate_directory_ancestry "$STATE_DIR"; validate_directory_ancestry "$QUADLET_DIR"; validate_directory_ancestry "$USER_UNIT_DIR"
    guard_generated_units; guard_existing_resources; cleanup_stale_admin_state; migrate_legacy_units; guard_systemd_units
    stop_units; "$SYSTEMCTL_BIN" --user daemon-reload
    printf 'Clash Lens is disabled and stopped; database, spool and fixture archive data were kept.\n'
    ;;
  status) (($# == 0)) || die "status takes no arguments"; status ;;
  logs) logs "$@" ;;
  queue-status) (($# == 0)) || die "queue-status takes no arguments"; exec_service ;;
  backup) (($# == 0)) || die "backup takes no arguments"; acquire_mutation_lock; backup ;;
  backup-status) (($# == 0)) || die "backup-status takes no arguments"; backup_status ;;
  backup-prune) acquire_mutation_lock; backup_prune "$@" ;;
  failed-items)
    acquire_mutation_lock
    failed_items "$@"
    ;;
  support-recovery-exec)
    acquire_mutation_lock; require_host; prepare_managed_runtime api
    [[ "$MANAGED_PREFIX" == clashlens ]] || die "support recovery is unavailable in fixture mode"
    "$PODMAN_BIN" exec --interactive "$MANAGED_PREFIX-python-api" python -m clashlens.cli recover-discord "$@"
    ;;
  help|-h|--help) usage ;;
  *) usage; die "unknown command $command" ;;
esac
