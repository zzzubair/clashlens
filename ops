validate_runtime_values() {
  local item
  for item in WEBSITE_PORT HEALTH_PORT WORKER_LEASE WORKER_CONCURRENCY WORKER_DB_POOL WORKER_ARCHIVE_POOL POSTGRES_PIDS COLLECTOR_PIDS API_PIDS WORKER_PIDS WEBSITE_PIDS; do
    validate_number "$item" "${!item}" integer
  done
  (( WEBSITE_PORT <= 65535 && HEALTH_PORT <= 65535 )) || die "published port is invalid"
  [[ "$WEBSITE_PORT" != "$HEALTH_PORT" ]] || die "website and health ports must differ"
  for item in POSTGRES_CPUS COLLECTOR_CPUS API_CPUS WORKER_CPUS WEBSITE_CPUS; do validate_number "$item" "${!item}" cpu; done
  for item in POSTGRES_MEMORY POSTGRES_SHM COLLECTOR_MEMORY API_MEMORY WORKER_MEMORY WEBSITE_MEMORY; do validate_number "$item" "${!item}" memory; done
  for item in PREFIX NETWORK_NAME POSTGRES_VOLUME SPOOL_ROOT STATE_DIR; do safe_env_value "$item" "${!item}"; done
  [[ -z "$ARCHIVE_ROOT" ]] || safe_env_value ARCHIVE_ROOT "$ARCHIVE_ROOT"
  validate_directory_ancestry "$STATE_DIR"
  validate_directory_ancestry "$STATE_DIR/env"
  validate_directory_ancestry "$SPOOL_ROOT"
  [[ -z "$ARCHIVE_ROOT" ]] || validate_directory_ancestry "$ARCHIVE_ROOT"
  validate_directory_ancestry "$QUADLET_DIR"
  validate_directory_ancestry "$USER_UNIT_DIR"
}

validate_directory_ancestry() {
  local path=$1 current= part
  local -a parts=()
  [[ "$path" == /* && "$path" != *'/../'* && "$path" != */.. && "$path" != *'/./'* && "$path" != */. && "$path" != *//* ]] || \
    die "$path must be a normalized absolute path"
  IFS='/' read -r -a parts <<< "${path#/}"
  for part in "${parts[@]}"; do
    [[ -n "$part" ]] || continue
    current="$current/$part"
    [[ ! -L "$current" ]] || die "$path has symlink ancestor $current"
    [[ ! -e "$current" || -d "$current" ]] || die "$path has non-directory ancestor $current"
  done
}

paths_overlap() {
  local left=${1%/} right=${2%/}
  [[ "$left" == "$right" || "$left" == "$right/"* || "$right" == "$left/"* ]]
}

validate_production_spool() {
  local spool protected
  spool=$(setting CLASHLENS_SPOOL_ROOT)
  validate_directory_ancestry "$spool"
  [[ -d "$spool" && ! -L "$spool" ]] || die "production spool must be a pre-created directory"
  [[ "$(stat -c '%u' "$spool")" == "$(id -u)" ]] || die "production spool must belong to the service account"
  [[ "$(stat -c '%a' "$spool")" == 700 ]] || die "production spool must have mode 700"
  for protected in "$HOME" "$ROOT" "$STATE_DIR" "$CONFIG_HOME" "$QUADLET_DIR" "$USER_UNIT_DIR" "$ENV_FILE" "${ENV_FILE%/*}" "$(setting CLASHLENS_API_KEY_HOST_DIR)"; do
    paths_overlap "$spool" "$protected" && die "production spool must not overlap $protected"
  done
  return 0
}

acquire_mutation_lock() {
  command -v flock >/dev/null 2>&1 || die "flock from Fedora util-linux is required"
  validate_directory_ancestry "$STATE_DIR"
  mkdir -p "$STATE_DIR"
  chmod 700 "$STATE_DIR"
  [[ "$(stat -c '%u' "$STATE_DIR")" == "$(id -u)" ]] || die "$STATE_DIR must belong to the service account"
  local lock_file="$STATE_DIR/ops.lock"
  [[ ! -L "$lock_file" ]] || die "refusing symlink operation lock $lock_file"
  [[ ! -e "$lock_file" || -f "$lock_file" && "$(stat -c '%u' "$lock_file")" == "$(id -u)" ]] || die "unsafe operation lock $lock_file"
  exec {OPS_LOCK_FD}> "$lock_file"
  chmod 600 "$lock_file"
  flock --nonblock "$OPS_LOCK_FD" || die "another Clash Lens build, lifecycle, or recovery operation is running"
}

managed_unit_file() {
  local file=$1 first=
  [[ ! -e "$file" ]] && return 0
  [[ -f "$file" && ! -L "$file" ]] || die "refusing to replace unmanaged path $file"
  IFS= read -r first < "$file" || true
  [[ "$first" == '# Managed by Clash Lens ./ops.' ]] || die "refusing to replace unmanaged unit $file"
}

guard_generated_units() {
  local template
  for template in "$TEMPLATE_DIR"/*.container "$TEMPLATE_DIR"/*.network "$TEMPLATE_DIR"/*.pod "$TEMPLATE_DIR"/*.volume; do
    managed_unit_file "$QUADLET_DIR/${template##*/}"
  done
  managed_unit_file "$USER_UNIT_DIR/clashlens.target"
  managed_unit_file "$USER_UNIT_DIR/clashlens-backup.service"
  managed_unit_file "$USER_UNIT_DIR/clashlens-backup.timer"
}

managed_label() {
  local kind=$1 name=$2 format
  case "$kind" in
    container) format='{{index .Config.Labels "org.clashlens.managed"}}' ;;
    secret) format='{{index .Spec.Labels "org.clashlens.managed"}}' ;;
    pod|network|volume) format='{{index .Labels "org.clashlens.managed"}}' ;;
    *) die "unknown managed resource type $kind" ;;
  esac
  "$PODMAN_BIN" "$kind" inspect --format "$format" "$name" 2>/dev/null || true
}

guard_resource() {
  local kind=$1 name=$2
  "$PODMAN_BIN" "$kind" exists "$name" >/dev/null 2>&1 || return 0
  [[ "$(managed_label "$kind" "$name")" == ops ]] || die "refusing to replace unmanaged Podman $kind $name"
}

guard_existing_resources() {
  local prefix resource
  for prefix in clashlens clashlens-ops-fixture; do
    for resource in postgres collector python-api python-worker website archive clash-api login admin-operation; do
      guard_resource container "$prefix-$resource"
    done
    guard_resource pod "$prefix-pod"
  done
  guard_resource network clashlens-private
  guard_resource network clashlens-ops-fixture-private
  guard_resource volume clashlens-postgres-data
  guard_resource volume clashlens-ops-fixture-postgres-data
  local secret
  for secret in clashlens-postgres-password clashlens-collector-database-url clashlens-worker-database-url clashlens-api-database-url \
    clashlens-collector-archive-access-key clashlens-collector-archive-secret-key clashlens-worker-archive-access-key clashlens-worker-archive-secret-key \
    clashlens-normal-api-keys clashlens-interactive-api-keys clashlens-interactive-1 clashlens-hmac-current clashlens-hmac-previous \
    clashlens-login-secret clashlens-google-client-secret clashlens-discord-client-secret clashlens-init-database-url clashlens-walg-config; do
    guard_resource secret "$secret"
  done
}

cleanup_stale_admin_containers() {
  local prefix name managed purpose
  for prefix in clashlens clashlens-ops-fixture; do
    name="$prefix-admin-operation"
    "$PODMAN_BIN" container exists "$name" >/dev/null 2>&1 || continue
    managed=$(managed_label container "$name")
    purpose=$($PODMAN_BIN inspect --format '{{index .Config.Labels "org.clashlens.purpose"}}' "$name" 2>/dev/null || true)
    [[ "$managed" == ops && "$purpose" == transient-admin ]] || { printf 'ops: refusing unmanaged transient container %s\n' "$name" >&2; return 1; }
    "$PODMAN_BIN" rm --force "$name" >/dev/null 2>&1 || return 1
    "$PODMAN_BIN" container exists "$name" >/dev/null 2>&1 && return 1
  done
}

cleanup_stale_admin_state() {
