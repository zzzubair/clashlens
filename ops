#!/usr/bin/env bash
set -Eeuo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
PODMAN_BIN=${PODMAN_BIN:-podman}
SYSTEMCTL_BIN=${SYSTEMCTL_BIN:-systemctl}
LOGINCTL_BIN=${LOGINCTL_BIN:-loginctl}
ENV_FILE=${OPS_ENV_FILE:-"$ROOT/app.env"}
STATE_DIR=${XDG_STATE_HOME:-"$HOME/.local/state"}/clashlens
CONFIG_HOME=${XDG_CONFIG_HOME:-"$HOME/.config"}
QUADLET_DIR=$CONFIG_HOME/containers/systemd
USER_UNIT_DIR=$CONFIG_HOME/systemd/user
RELEASE_DIR="$ROOT/.clashlens-ops"
RELEASE_FILE="$RELEASE_DIR/release.env"
ACTIVE_RELEASE_FILE="$STATE_DIR/active-release.env"
TEMPLATE_DIR="$ROOT/deploy/quadlet"
CANONICAL_REPOSITORY_URL=https://github.com/zzzubair/clashlens
declare -Ag CONFIG=()
declare -Ag RELEASE=()
ADMIN_SECRET_ACTIVE=false
UP_IN_PROGRESS=false
OPS_LOCK_FD=

usage() {
  cat <<'EOF'
Usage: ./ops build [--fixture]
       ./ops up [--fixture]
       ./ops down
       ./ops status
       ./ops logs [postgres|collector|api|worker|website|archive|clash-api|login]
       ./ops queue-status
       ./ops backup
       ./ops backup-status
       ./ops backup-prune [--apply]
       ./ops failed-items [--limit N|--work-id N|--upload-hash SHA256] [--apply]
       ./ops support-recovery-exec <arguments>

build creates a pinned release. up installs and starts that release; it never
builds or pulls an image. --fixture is an isolated stack with no live keys.
down disables the stack across reboot and keeps all database, spool and archive data.
EOF
}

die() {
  printf 'ops: %s\n' "$*" >&2
  exit 1
}

cleanup_admin_secret() {
  [[ "$ADMIN_SECRET_ACTIVE" == true ]] || return 0
  cleanup_stale_admin_containers || return 1
  if ! "$PODMAN_BIN" secret rm clashlens-init-database-url >/dev/null 2>&1 || \
      "$PODMAN_BIN" secret exists clashlens-init-database-url >/dev/null 2>&1; then
    printf 'ops: could not remove the transient admin database secret\n' >&2
    return 1
  fi
  ADMIN_SECRET_ACTIVE=false
}

finish() {
  local result=$?
  trap - EXIT HUP INT TERM
  cleanup_admin_secret || result=1
  if (( result != 0 )) && [[ "$UP_IN_PROGRESS" == true ]]; then
    "$SYSTEMCTL_BIN" --user stop clashlens-backup.timer clashlens-backup.service >/dev/null 2>&1 || true
    "$SYSTEMCTL_BIN" --user disable --now clashlens.target >/dev/null 2>&1 || true
    local unit
    for unit in clashlens-website clashlens-collector clashlens-api clashlens-worker clashlens-login clashlens-clash-api clashlens-archive clashlens-postgres clashlens-pod clashlens-network clashlens-postgres-volume; do
      "$SYSTEMCTL_BIN" --user stop "$unit.service" >/dev/null 2>&1 || true
    done
  fi
  exit "$result"
}

trap finish EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

trim() {
  local value=$1
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

parse_mode() {
  MODE=production
  if (($#)); then
    [[ $# == 1 && "$1" == --fixture ]] || die "expected only --fixture"
    MODE=fixture
  fi
}

require_host() {
  command -v "$PODMAN_BIN" >/dev/null 2>&1 || die "Podman is required"
  command -v "$SYSTEMCTL_BIN" >/dev/null 2>&1 || die "systemd is required"
  "$PODMAN_BIN" info >/dev/null 2>&1 || die "rootless Podman is unavailable"
  [[ "$($PODMAN_BIN info --format '{{.Host.Security.Rootless}}')" == true ]] || \
    die "./ops requires rootless Podman"
  "$SYSTEMCTL_BIN" --user show-environment >/dev/null 2>&1 || \
    die "the systemd user manager is unavailable"
}

load_kv_file() {
  local file=$1 target=$2 raw line name value
  [[ -r "$file" ]] || die "cannot read $file"
  while IFS= read -r raw || [[ -n "$raw" ]]; do
    line=$(trim "$raw")
    [[ -z "$line" || "${line:0:1}" == '#' ]] && continue
    [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || \
      die "$file contains an invalid setting"
    name=${BASH_REMATCH[1]}
    value=${BASH_REMATCH[2]}
    [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || die "$file contains a multiline value"
    if [[ "$target" == CONFIG ]]; then CONFIG["$name"]=$value; else RELEASE["$name"]=$value; fi
  done < "$file"
}

setting() {
  local name=$1 fallback=${2-}
  printf '%s' "${CONFIG[$name]-$fallback}"
}

require_setting() {
  local name=$1 value=${CONFIG[$name]-}
  [[ -n "$value" && "$value" != CHANGE_ME && "$value" != *example.invalid* ]] || \
    die "$name must be set in app.env"
}

safe_env_value() {
  local name=$1 value=$2
  [[ -n "$value" && "$value" != *[[:space:]]* && "$value" != *'%'* ]] || \
    die "$name contains characters unsupported by the unit environment file"
}

validate_number() {
  local name=$1 value=$2 kind=$3
  case "$kind" in
    integer) [[ "$value" =~ ^[1-9][0-9]*$ ]] ;;
    cpu) [[ "$value" =~ ^[0-9]+([.][0-9]+)?$ && "$value" != 0 ]] ;;
    memory) [[ "$value" =~ ^[1-9][0-9]*[bBkKmMgGtT]?$ ]] ;;
  esac || die "$name is invalid"
}

load_production_config() {
  [[ "$ENV_FILE" == /* ]] || die "app.env path must be absolute"
  validate_directory_ancestry "${ENV_FILE%/*}"
  [[ -f "$ENV_FILE" && ! -L "$ENV_FILE" ]] || die "missing or unsafe app.env; copy app.env.example and chmod 600 app.env"
  [[ "$(stat -c '%u' "$ENV_FILE")" == "$(id -u)" ]] || die "app.env must belong to the service account"
  [[ "$(stat -c '%a' "$ENV_FILE")" == 600 ]] || die "app.env must have mode 600"
  load_kv_file "$ENV_FILE" CONFIG
  local required=(POSTGRES_DB POSTGRES_USER POSTGRES_PASSWORD
    CLASHLENS_COLLECTOR_DB_PASSWORD CLASHLENS_WORKER_DB_PASSWORD CLASHLENS_API_DB_PASSWORD
    CLASHLENS_ARCHIVE_ENDPOINT CLASHLENS_ARCHIVE_REGION CLASHLENS_ARCHIVE_INSTANCE_ID
    CLASHLENS_ARCHIVE_MARKER_KEY CLASHLENS_ARCHIVE_MARKER_HASH
    CLASHLENS_ARCHIVE_MARKER_PAYLOAD_VERSION CLASHLENS_ARCHIVE_BUCKET
    CLASHLENS_ARCHIVE_ACCESS_KEY CLASHLENS_ARCHIVE_SECRET_KEY
    CLASHLENS_WORKER_ARCHIVE_ACCESS_KEY CLASHLENS_WORKER_ARCHIVE_SECRET_KEY
    CLASHLENS_SPOOL_ROOT CLASHLENS_OFFICIAL_API_ORIGIN CLASHLENS_OFFICIAL_API_PROXY_URL
    CLASHLENS_API_KEY_HOST_DIR CLASHLENS_HMAC_SECRET_FILE)
  local name
  for name in "${required[@]}"; do require_setting "$name"; done
  [[ "$(setting CLASHLENS_ARCHIVE_SECURE)" == true ]] || die "production archive transport must be secure"
  [[ "$(setting CLASHLENS_ARCHIVE_ENDPOINT)" =~ ^[A-Za-z0-9._:-]+$ && "$(setting CLASHLENS_ARCHIVE_ENDPOINT)" != *://* && "$(setting CLASHLENS_ARCHIVE_ENDPOINT)" != */* ]] || die "CLASHLENS_ARCHIVE_ENDPOINT must be a host and port without a scheme or path"
  [[ "$(setting CLASHLENS_ARCHIVE_BUCKET)" =~ ^[A-Za-z0-9._-]{3,63}$ ]] || die "CLASHLENS_ARCHIVE_BUCKET is invalid"
  [[ "$(setting CLASHLENS_ARCHIVE_REGION)" =~ ^[A-Za-z0-9._-]{1,64}$ ]] || die "CLASHLENS_ARCHIVE_REGION is invalid"
  [[ "$(setting CLASHLENS_ARCHIVE_INSTANCE_ID)" =~ ^[A-Za-z0-9._:-]{1,128}$ ]] || die "CLASHLENS_ARCHIVE_INSTANCE_ID is invalid"
  [[ "$(setting CLASHLENS_ARCHIVE_MARKER_KEY)" =~ ^[A-Za-z0-9._/-]+$ && "$(setting CLASHLENS_ARCHIVE_MARKER_KEY)" != /* && "$(setting CLASHLENS_ARCHIVE_MARKER_KEY)" != *..* ]] || die "CLASHLENS_ARCHIVE_MARKER_KEY must be a safe relative key"
  [[ "$(setting CLASHLENS_ARCHIVE_MARKER_HASH)" =~ ^[0-9a-f]{64}$ ]] || die "CLASHLENS_ARCHIVE_MARKER_HASH must be lowercase SHA-256"
  [[ "$(setting CLASHLENS_ARCHIVE_MARKER_PAYLOAD_VERSION)" =~ ^[A-Za-z0-9._-]{1,32}$ ]] || die "CLASHLENS_ARCHIVE_MARKER_PAYLOAD_VERSION is invalid"
  [[ "$(setting CLASHLENS_OFFICIAL_API_ORIGIN)" =~ ^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?$ ]] || die "production official API origin must be one HTTPS origin without a path"
  [[ "$(setting CLASHLENS_SPOOL_ROOT)" == /* && "$(setting CLASHLENS_SPOOL_ROOT)" != / ]] || die "CLASHLENS_SPOOL_ROOT must be an absolute non-root path"
  [[ ! -L "$(setting CLASHLENS_SPOOL_ROOT)" ]] || die "CLASHLENS_SPOOL_ROOT must not be a symlink"
  [[ "$(setting CLASHLENS_API_KEY_HOST_DIR)" == /* && "$(setting CLASHLENS_API_KEY_HOST_DIR)" != / ]] || die "CLASHLENS_API_KEY_HOST_DIR must be an absolute non-root path"
  validate_production_spool
  [[ "$(setting CLASHLENS_PLAYER_DISCOVERY_ENABLED false)" == false ]] || \
    die "production discovery is disabled by issue #110; remove or set CLASHLENS_PLAYER_DISCOVERY_ENABLED=false"
  [[ "$(setting CLASHLENS_GLOBAL_RANKINGS_ENABLED false)" =~ ^(true|false)$ ]] || \
    die "CLASHLENS_GLOBAL_RANKINGS_ENABLED must be true or false"
  local previous_id previous_file
  previous_id=$(setting CLASHLENS_HMAC_PREVIOUS_KEY_ID)
  previous_file=$(setting CLASHLENS_HMAC_PREVIOUS_SECRET_FILE)
  [[ -z "$previous_id" && -z "$previous_file" || -n "$previous_id" && -n "$previous_file" ]] || \
    die "previous HMAC key ID and secret file must be configured together"
  [[ -z "$previous_id" || "$previous_id" != "$(setting CLASHLENS_HMAC_KEY_ID current)" ]] || \
    die "current and previous HMAC key IDs must differ"
  [[ "$(setting CLASHLENS_HMAC_CALLER typescript-website)" =~ ^[A-Za-z0-9._-]{1,64}$ ]] || die "CLASHLENS_HMAC_CALLER is invalid"
  [[ "$(setting CLASHLENS_HMAC_KEY_ID current)" =~ ^[A-Za-z0-9._-]{1,64}$ ]] || die "CLASHLENS_HMAC_KEY_ID is invalid"
  [[ -z "$previous_id" || "$previous_id" =~ ^[A-Za-z0-9._-]{1,64}$ ]] || die "CLASHLENS_HMAC_PREVIOUS_KEY_ID is invalid"
  local secret_path
  for secret_path in "$(setting CLASHLENS_HMAC_SECRET_FILE)" "$previous_file"; do
    [[ -z "$secret_path" || "$secret_path" =~ ^/run/secrets/[A-Za-z0-9._-]+$ ]] || die "HMAC secret paths must be direct files under /run/secrets"
  done
  local numeric
  for numeric in CLASHLENS_SPOOL_MAX_BYTES CLASHLENS_SPOOL_MAX_OBJECTS CLASHLENS_SPOOL_FREE_SPACE_FLOOR CLASHLENS_SPOOL_FREE_INODE_FLOOR CLASHLENS_MAX_BODY_BYTES; do
    [[ "$(setting "$numeric" 1)" =~ ^(0|[1-9][0-9]*)$ ]] || die "$numeric must be a non-negative integer"
  done
  (( $(setting CLASHLENS_SPOOL_MAX_BYTES 17179869184) > 0 && $(setting CLASHLENS_SPOOL_MAX_OBJECTS 1000000) > 0 && $(setting CLASHLENS_MAX_BODY_BYTES 4194304) > 0 )) || die "spool caps and maximum body bytes must be positive"
  local proxy
  proxy=$(setting CLASHLENS_OFFICIAL_API_PROXY_URL)
  [[ "$proxy" =~ ^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?$ ]] || die "CLASHLENS_OFFICIAL_API_PROXY_URL must be one HTTP(S) origin without credentials or path"
  local public_origin
  public_origin=$(setting CLASHLENS_PUBLIC_ORIGIN)
  [[ -z "$public_origin" || "$public_origin" =~ ^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?$ ]] || die "CLASHLENS_PUBLIC_ORIGIN must be one HTTPS origin"
  if [[ -n "$public_origin" ]]; then
    for name in CLASHLENS_LOGIN_SECRET_FILE CLASHLENS_GOOGLE_CLIENT_ID CLASHLENS_GOOGLE_CLIENT_SECRET_FILE CLASHLENS_DISCORD_CLIENT_ID CLASHLENS_DISCORD_CLIENT_SECRET_FILE; do require_setting "$name"; done
    for secret_path in "$(setting CLASHLENS_LOGIN_SECRET_FILE)" "$(setting CLASHLENS_GOOGLE_CLIENT_SECRET_FILE)" "$(setting CLASHLENS_DISCORD_CLIENT_SECRET_FILE)"; do
      [[ "$secret_path" =~ ^/run/secrets/[A-Za-z0-9._-]+$ ]] || die "login secret paths must be direct files under /run/secrets"
    done
    [[ "$(setting CLASHLENS_GOOGLE_CLIENT_ID)" =~ ^[A-Za-z0-9._~-]{1,256}$ ]] || die "CLASHLENS_GOOGLE_CLIENT_ID is invalid"
    [[ "$(setting CLASHLENS_DISCORD_CLIENT_ID)" =~ ^[0-9]{17,20}$ ]] || die "CLASHLENS_DISCORD_CLIENT_ID is invalid"
  fi
  for name in POSTGRES_PASSWORD CLASHLENS_COLLECTOR_DB_PASSWORD CLASHLENS_WORKER_DB_PASSWORD CLASHLENS_API_DB_PASSWORD; do
    [[ "${CONFIG[$name]}" =~ ^[A-Za-z0-9_-]{32,128}$ ]] || die "$name must be 32-128 URL-safe characters"
  done
  POSTGRES_DB=$(setting POSTGRES_DB)
  POSTGRES_USER=$(setting POSTGRES_USER)
  [[ "$POSTGRES_DB" =~ ^[A-Za-z_][A-Za-z0-9_]*$ && "$POSTGRES_USER" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "PostgreSQL names are invalid"
  validate_production_secret_files
  validate_backup_config
  PREFIX=clashlens
  NETWORK_NAME=clashlens-private
  POSTGRES_VOLUME=clashlens-postgres-data
  SPOOL_ROOT=$(setting CLASHLENS_SPOOL_ROOT)
  ARCHIVE_ROOT=
  WEBSITE_PORT=$(setting CLASHLENS_WEBSITE_PORT 3000)
  HEALTH_PORT=$(setting CLASHLENS_HEALTH_PORT 8081)
  WORKER_LEASE=$(setting CLASHLENS_WORKER_LEASE_SECONDS 60)
  WORKER_CONCURRENCY=$(setting CLASHLENS_WORKER_CONCURRENCY 12)
  WORKER_DB_POOL=$(setting CLASHLENS_WORKER_DATABASE_POOL_SIZE 12)
  WORKER_ARCHIVE_POOL=$(setting CLASHLENS_WORKER_ARCHIVE_POOL_SIZE 12)
  POSTGRES_MEMORY=$(setting CLASHLENS_POSTGRES_MEMORY 4g)
  POSTGRES_SHM=$(setting CLASHLENS_POSTGRES_SHM_SIZE 1g)
  POSTGRES_CPUS=$(setting CLASHLENS_POSTGRES_CPUS 4)
  POSTGRES_PIDS=$(setting CLASHLENS_POSTGRES_PIDS 512)
  COLLECTOR_MEMORY=$(setting CLASHLENS_COLLECTOR_MEMORY 2g)
  COLLECTOR_CPUS=$(setting CLASHLENS_COLLECTOR_CPUS 4)
  COLLECTOR_PIDS=$(setting CLASHLENS_COLLECTOR_PIDS 512)
  API_MEMORY=$(setting CLASHLENS_API_MEMORY 1g)
  API_CPUS=$(setting CLASHLENS_API_CPUS 2)
  API_PIDS=$(setting CLASHLENS_API_PIDS 256)
  WORKER_MEMORY=$(setting CLASHLENS_WORKER_MEMORY 4g)
  WORKER_CPUS=$(setting CLASHLENS_WORKER_CPUS 6)
  WORKER_PIDS=$(setting CLASHLENS_WORKER_PIDS 512)
  WEBSITE_MEMORY=$(setting CLASHLENS_WEBSITE_MEMORY 1g)
  WEBSITE_CPUS=$(setting CLASHLENS_WEBSITE_CPUS 2)
  WEBSITE_PIDS=$(setting CLASHLENS_WEBSITE_PIDS 256)
  COLLECTOR_ARGS=
  API_ARGS=
  WORKER_ARGS=--disable-player-discovery
}

