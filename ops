render() {
  local source=$1 destination=$2 content token value
  managed_unit_file "$destination"
  content=$(<"$source")
  while (($# > 2)); do
    token=$3
    value=$4
    shift 2
    content=${content//"@@$token@@"/$value}
  done
  [[ "$content" != *'@@'* ]] || die "unrendered value in ${source##*/}"
  local temporary
  temporary=$(mktemp "${destination}.XXXXXX")
  printf '%s\n' "$content" > "$temporary"
  chmod 644 "$temporary"
  mv -f "$temporary" "$destination"
}

