guard_systemd_units() {
  local unit source fragment expected
  local -A sources=(
    [clashlens-postgres.service]="$QUADLET_DIR/clashlens-postgres.container"
    [clashlens-collector.service]="$QUADLET_DIR/clashlens-collector.container"
    [clashlens-api.service]="$QUADLET_DIR/clashlens-api.container"
    [clashlens-worker.service]="$QUADLET_DIR/clashlens-worker.container"
    [clashlens-website.service]="$QUADLET_DIR/clashlens-website.container"
    [clashlens-archive.service]="$QUADLET_DIR/clashlens-archive.container"
    [clashlens-clash-api.service]="$QUADLET_DIR/clashlens-clash-api.container"
    [clashlens-login.service]="$QUADLET_DIR/clashlens-login.container"
    [clashlens-pod.service]="$QUADLET_DIR/clashlens.pod"
    [clashlens-network.service]="$QUADLET_DIR/clashlens.network"
    [clashlens-postgres-volume.service]="$QUADLET_DIR/clashlens-postgres.volume"
  )
  for unit in "${!sources[@]}"; do
    fragment=$($SYSTEMCTL_BIN --user show "$unit" --property=FragmentPath --value 2>/dev/null || true)
    [[ -z "$fragment" ]] && continue
    source=$($SYSTEMCTL_BIN --user show "$unit" --property=SourcePath --value 2>/dev/null || true)
    expected=${sources[$unit]}
    [[ "$source" == "$expected" ]] || die "refusing unmanaged systemd unit $unit"
  done
  fragment=$($SYSTEMCTL_BIN --user show clashlens.target --property=FragmentPath --value 2>/dev/null || true)
  [[ -z "$fragment" || "$fragment" == "$USER_UNIT_DIR/clashlens.target" ]] || die "refusing unmanaged systemd unit clashlens.target"
  for unit in clashlens-backup.service clashlens-backup.timer; do
    fragment=$($SYSTEMCTL_BIN --user show "$unit" --property=FragmentPath --value 2>/dev/null || true)
    [[ -z "$fragment" || "$fragment" == "$USER_UNIT_DIR/$unit" ]] || die "refusing unmanaged systemd unit $unit"
  done
  for unit in clashlens.service clashlens-python-api.service clashlens-python-worker.service; do
    fragment=$($SYSTEMCTL_BIN --user show "$unit" --property=FragmentPath --value 2>/dev/null || true)
    [[ -z "$fragment" ]] || die "refusing unmanaged legacy systemd unit $unit"
  done
}

migrate_legacy_units() {
  local unit file digest expected enabled
  local -A hashes=(
    [clashlens.service]=5f80e7a4a59439bec927f760d60279961a77d234efa59eb14e9f39f9ad75c071
    [clashlens-python-api.service]=0b7fed1118d99aed28bdcc35a301c7a0b00251b050acef42f64d3638946205d5
    [clashlens-python-worker.service]=69b1e6c2f90e26096dfe934ca9e653ca7a52465aedd9ccf9a5f51f20afc0445d
    [clashlens-website.service]=85385a87cab7fcb05b09399f760338aabf020b0f389e414e3bfb4c8eab380b66
  )
  for unit in "${!hashes[@]}"; do
    file="$USER_UNIT_DIR/$unit"
    if [[ -e "$file" ]]; then
      [[ -f "$file" && ! -L "$file" ]] || die "refusing to replace unmanaged legacy unit $file"
      digest=$(sha256sum "$file" | cut -d' ' -f1)
      expected=${hashes[$unit]}
      [[ "$digest" == "$expected" ]] || die "refusing to replace modified legacy unit $file"
      "$SYSTEMCTL_BIN" --user disable --now "$unit" >/dev/null || die "could not disable legacy $unit"
      rm -- "$file"
    else
      enabled=$($SYSTEMCTL_BIN --user is-enabled "$unit" 2>/dev/null || true)
      [[ "$enabled" != enabled && "$enabled" != enabled-runtime ]] || die "enabled legacy $unit has no known deployment file"
    fi
  done
  "$SYSTEMCTL_BIN" --user daemon-reload
}

source_revision() {
  git -C "$ROOT" rev-parse --verify HEAD^{commit} 2>/dev/null || die "cannot resolve the source revision"
}

source_fingerprint() {
  local file relative digest
  while IFS= read -r -d '' file; do
    relative=${file#"$ROOT/"}
    digest=$(sha256sum "$file" | cut -d' ' -f1)
    printf '%s\0%s\n' "$relative" "$digest"
  done < <(git -C "$ROOT" ls-files -co --exclude-standard -z -- .containerignore Containerfile python website development deploy/migrations deploy/quadlet deploy/postgres ops | sort -z | \
    while IFS= read -r -d '' relative; do printf '%s\0' "$ROOT/$relative"; done)
}

image_id() {
  local identifier
  identifier=$("$PODMAN_BIN" image inspect --format '{{.Id}}' "$1" 2>/dev/null) || die "image $1 is missing"
  identifier=${identifier#sha256:}
  [[ "$identifier" =~ ^[0-9a-f]{64}$ ]] || die "image $1 returned an invalid ID"
  printf 'sha256:%s\n' "$identifier"
}

normalize_image_id() {
  local identifier=${1#sha256:}
  [[ "$identifier" =~ ^[0-9a-f]{64}$ ]] || die "container returned an invalid image ID"
  printf 'sha256:%s\n' "$identifier"
}

build_release() {
  require_host
  mkdir -p "$RELEASE_DIR"
  local revision fingerprint final_fingerprint collector_tag python_tag website_tag postgres_tag fixtures_tag login_tag temporary
  revision=$(source_revision)
  fingerprint=$(source_fingerprint | sha256sum | cut -d' ' -f1)
  collector_tag=localhost/clashlens-release-collector
  python_tag=localhost/clashlens-release-python
  website_tag=localhost/clashlens-release-website
  postgres_tag=docker.io/library/postgres:18-alpine
  "$PODMAN_BIN" build --pull=missing --file "$ROOT/Containerfile" --label "org.opencontainers.image.source=$CANONICAL_REPOSITORY_URL" --label "org.opencontainers.image.revision=$revision" --tag "$collector_tag" "$ROOT"
  "$PODMAN_BIN" build --pull=missing --file "$ROOT/python/Containerfile" --label "org.opencontainers.image.source=$CANONICAL_REPOSITORY_URL" --label "org.opencontainers.image.revision=$revision" --tag "$python_tag" "$ROOT/python"
  "$PODMAN_BIN" build --pull=missing --file "$ROOT/website/Containerfile" --label "org.opencontainers.image.source=$CANONICAL_REPOSITORY_URL" --label "org.opencontainers.image.revision=$revision" --tag "$website_tag" "$ROOT/website"
  if [[ "$MODE" == production ]]; then
    postgres_tag=localhost/clashlens-release-postgres
    "$PODMAN_BIN" build --pull=missing --file "$ROOT/deploy/postgres/Containerfile" --label "org.opencontainers.image.source=$CANONICAL_REPOSITORY_URL" --label "org.opencontainers.image.revision=$revision" --tag "$postgres_tag" "$ROOT/deploy/postgres"
  else
    "$PODMAN_BIN" pull "$postgres_tag" >/dev/null
  fi
  fixtures_tag=
  login_tag=
  if [[ "$MODE" == fixture ]]; then
    fixtures_tag=localhost/clashlens-release-fixtures
    login_tag=localhost/clashlens-release-login
    "$PODMAN_BIN" build --pull=missing --file "$ROOT/development/Containerfile" --tag "$fixtures_tag" "$ROOT"
    "$PODMAN_BIN" build --pull=missing --target fixtures --file "$ROOT/website/Containerfile" --tag "$login_tag" "$ROOT/website"
  fi
  final_fingerprint=$(source_fingerprint | sha256sum | cut -d' ' -f1)
  [[ "$final_fingerprint" == "$fingerprint" ]] || die "release inputs changed during build; run ./ops build again"
  temporary=$(mktemp "$RELEASE_DIR/release.env.XXXXXX")
  chmod 600 "$temporary"
  {
    printf 'RELEASE_MODE=%s\n' "$MODE"
    printf 'SOURCE_REVISION=%s\n' "$revision"
    printf 'SOURCE_FINGERPRINT=%s\n' "$fingerprint"
    printf 'COLLECTOR_IMAGE=%s\n' "$(image_id "$collector_tag")"
    printf 'PYTHON_IMAGE=%s\n' "$(image_id "$python_tag")"
    printf 'WEBSITE_IMAGE=%s\n' "$(image_id "$website_tag")"
    printf 'POSTGRES_IMAGE=%s\n' "$(image_id "$postgres_tag")"
    [[ -z "$fixtures_tag" ]] || printf 'FIXTURES_IMAGE=%s\n' "$(image_id "$fixtures_tag")"
    [[ -z "$login_tag" ]] || printf 'LOGIN_IMAGE=%s\n' "$(image_id "$login_tag")"
  } > "$temporary"
  mv -f "$temporary" "$RELEASE_FILE"
  printf 'Release %s built from %s; run ./ops up%s separately.\n' "$MODE" "$revision" "$([[ "$MODE" == fixture ]] && printf ' --fixture')"
}

load_release() {
  [[ -f "$RELEASE_FILE" ]] || die "no release is built; run ./ops build first"
  RELEASE=()
  load_kv_file "$RELEASE_FILE" RELEASE
  [[ "${RELEASE[RELEASE_MODE]-}" == "$MODE" ]] || die "built release is ${RELEASE[RELEASE_MODE]-unknown}; build the $MODE release first"
  local current_fingerprint
  current_fingerprint=$(source_fingerprint | sha256sum | cut -d' ' -f1)
  [[ "${RELEASE[SOURCE_FINGERPRINT]-}" == "$current_fingerprint" ]] || \
    die "release inputs changed after build; run ./ops build again before up"
  local name
  for name in COLLECTOR_IMAGE PYTHON_IMAGE WEBSITE_IMAGE POSTGRES_IMAGE; do
    [[ "${RELEASE[$name]-}" =~ ^sha256:[0-9a-f]{64}$ ]] || die "release manifest has an invalid $name"
    "$PODMAN_BIN" image exists "${RELEASE[$name]}" || die "pinned $name is missing; run ./ops build again"
  done
  if [[ "$MODE" == fixture ]]; then
    for name in FIXTURES_IMAGE LOGIN_IMAGE; do
      [[ "${RELEASE[$name]-}" =~ ^sha256:[0-9a-f]{64}$ ]] || die "release manifest has an invalid $name"
      "$PODMAN_BIN" image exists "${RELEASE[$name]}" || die "pinned $name is missing; run ./ops build --fixture again"
    done
  fi
}

load_active_release() {
  [[ -f "$ACTIVE_RELEASE_FILE" && ! -L "$ACTIVE_RELEASE_FILE" ]] || die "no active release is recorded; run ./ops up first"
  [[ "$(stat -c '%a' "$ACTIVE_RELEASE_FILE")" == 600 ]] || die "active release record must have mode 600"
  RELEASE=()
  load_kv_file "$ACTIVE_RELEASE_FILE" RELEASE
  [[ "${RELEASE[RELEASE_MODE]-}" == "$MODE" ]] || die "active release mode does not match the installed stack"
  local name
  for name in COLLECTOR_IMAGE PYTHON_IMAGE WEBSITE_IMAGE POSTGRES_IMAGE; do
    [[ "${RELEASE[$name]-}" =~ ^sha256:[0-9a-f]{64}$ ]] || die "active release has an invalid $name"
    "$PODMAN_BIN" image exists "${RELEASE[$name]}" || die "active release image $name is missing"
  done
  if [[ "$MODE" == fixture ]]; then
    for name in FIXTURES_IMAGE LOGIN_IMAGE; do
      [[ "${RELEASE[$name]-}" =~ ^sha256:[0-9a-f]{64}$ ]] || die "active release has an invalid $name"
      "$PODMAN_BIN" image exists "${RELEASE[$name]}" || die "active release image $name is missing"
    done
  fi
}

promote_active_release() {
  local temporary
  temporary=$(mktemp "$STATE_DIR/active-release.env.XXXXXX")
  chmod 600 "$temporary"
  cat -- "$RELEASE_FILE" > "$temporary"
  mv -f "$temporary" "$ACTIVE_RELEASE_FILE"
